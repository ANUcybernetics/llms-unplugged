{
  "name": "llms-unplugged",
  "version": "2.0.0",
  "description": "Static website for LLMs Unplugged teaching resources",
  "homepage": "https://www.llmsunplugged.org",
  "license": "MIT",
  "author": "ANU School of Cybernetics",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANUcybernetics/llms-unplugged"
  },
  "type": "module",
  "scripts": {
    "predev": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "dev": "astro dev",
    "prebuild": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "build": "astro build",
    "preview": "astro preview",
    "new": "pnpm exec tsx scripts/create-news-item.ts",
    "build:pdfs": "pnpm exec tsx scripts/build-lesson-pdfs.ts",
    "generate:image": "pnpm exec tsx scripts/generate-image.ts",
    "convert:avif": "pnpm exec tsx scripts/convert-images-to-avif.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . && stylelint 'src/**/*.css'",
    "lint:fix": "oxlint --fix . && stylelint --fix 'src/**/*.css'",
    "lint:css": "stylelint 'src/**/*.css'",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "format": "oxfmt --write '**/*.{js,ts,md,mdx,css,json,yaml,yml}' && prettier --write '**/*.{astro,svelte}'",
    "format:check": "oxfmt --check '**/*.{js,ts,md,mdx,css,json,yaml,yml}' && prettier --check '**/*.{astro,svelte}'",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/svelte": "^8.0.0",
    "astro": "^6.0.0",
    "astromotion": "github:benswift/astromotion",
    "js-yaml": "^4.1.1",
    "lightningcss": "^1.32.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.624",
    "reveal.js": "^6.0.0",
    "svelte": "^5.0.0",
    "astro-theme-anu": "*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@e18e/eslint-plugin": "^0.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.0.0",
    "markdown-it": "^14.1.0",
    "oxfmt": "latest",
    "oxlint": "^1.48.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-svelte": "^3.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-smartypants": "^3.0.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "astro-theme-anu": "file:/home/ben/projects/astro-theme-anu/.worktrees/customisation-knobs/packages/astro-theme-anu"
    }
  }
}
