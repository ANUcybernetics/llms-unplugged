{
  "name": "llms-unplugged",
  "version": "1.5.0",
  "description": "Static website for LLMs Unplugged teaching resources",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANUcybernetics/llms-unplugged"
  },
  "homepage": "https://www.llmsunplugged.org",
  "author": "ANU School of Cybernetics",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "new": "npx tsx scripts/create-news-item.ts",
    "build:pdfs": "npx tsx scripts/build-lesson-pdfs.ts",
    "generate:image": "npx tsx scripts/generate-image.ts",
    "convert:avif": "npx tsx scripts/convert-images-to-avif.ts",
    "preview": "vitepress preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "gray-matter": "^4.0.3",
    "jsdom": "^27.2.0",
    "markdown-it": "^14.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.48.1",
    "vite-plugin-checker": "^0.12.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-rss": "^0.4.1",
    "vitest": "^4.0.14",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.5"
  },
  "dependencies": {
    "mammoth": "^1.11.0",
    "markdown-it-footnote": "^4.0.0",
    "pdfjs-dist": "^5.4.449"
  }
}
