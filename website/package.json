{
  "name": "llms-unplugged",
  "version": "2.0.0",
  "description": "Static website for LLMs Unplugged teaching resources",
  "homepage": "https://www.llmsunplugged.org",
  "license": "MIT",
  "author": "ANU School of Cybernetics",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANUcybernetics/llms-unplugged"
  },
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:a11y": "CHECK_A11Y=true pnpm run build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run decks:check",
    "convert:avif": "pnpm exec tsx scripts/convert-images-to-avif.ts",
    "decks:check": "astromotion-check",
    "dev": "astro dev",
    "format": "oxfmt . && prettier --write --log-level warn '**/*.astro'",
    "format:check": "oxfmt --check . && prettier --check --log-level warn '**/*.astro'",
    "generate:image": "pnpm exec tsx scripts/generate-image.ts",
    "lint": "oxlint && pnpm lint:css",
    "lint:css": "stylelint 'src/**/*.css' --allow-empty-input",
    "lint:css:fix": "stylelint 'src/**/*.css' --fix --allow-empty-input",
    "lint:fix": "oxlint --fix && pnpm lint:css:fix",
    "new": "pnpm exec tsx scripts/create-news-item.ts",
    "pdf": "astromotion-pdf",
    "prebuild": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "predev": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "astro": "^7.3.1",
    "astro-theme-anu": "git+https://gitlab.anu.edu.au/u2548636/astro-theme-anu.git#astro-theme-anu@v0.9.2&path:/packages/astro-theme-anu",
    "astro-theme-university": "github:ANUcybernetics/astro-theme-university#v0.14.4",
    "astromotion": "github:ANUcybernetics/astromotion#v0.25.2",
    "lightningcss": "^1.33.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "svelte": "^5.57.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@e18e/eslint-plugin": "^0.8.0",
    "@iconify-json/iconoir": "^1.2.11",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer-core": "^25.10.0",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
