{
  "name": "llms-unplugged",
  "version": "2.0.0",
  "description": "Static website for LLMs Unplugged teaching resources",
  "homepage": "https://www.llmsunplugged.org",
  "license": "MIT",
  "author": "ANU School of Cybernetics",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANUcybernetics/llms-unplugged"
  },
  "type": "module",
  "scripts": {
    "predev": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "dev": "astro dev",
    "prebuild": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "build": "astro build",
    "preview": "astro preview",
    "new": "pnpm exec tsx scripts/create-news-item.ts",
    "generate:image": "pnpm exec tsx scripts/generate-image.ts",
    "convert:avif": "pnpm exec tsx scripts/convert-images-to-avif.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . && stylelint 'src/**/*.css'",
    "lint:fix": "oxlint --fix . && stylelint --fix 'src/**/*.css'",
    "lint:css": "stylelint 'src/**/*.css'",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "format": "oxfmt --write '**/*.{js,ts,md,mdx,css,json,yaml,yml}' && prettier --write '**/*.{astro,svelte}'",
    "format:check": "oxfmt --check '**/*.{js,ts,md,mdx,css,json,yaml,yml}' && prettier --check '**/*.{astro,svelte}'",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/svelte": "^8.1.0",
    "astro": "^6.2.1",
    "astro-theme-anu": "git+https://gitlab.anu.edu.au/u2548636/astro-theme-anu.git#main&path:/packages/astro-theme-anu",
    "astromotion": "github:benswift/astromotion",
    "js-yaml": "^4.1.1",
    "lightningcss": "^1.32.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284",
    "reveal.js": "^6.0.1",
    "svelte": "^5.55.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@e18e/eslint-plugin": "^0.4.1",
    "@iconify-json/iconoir": "^1.2.11",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/svelte": "^5.3.1",
    "@types/js-yaml": "^4.0.9",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.1.1",
    "oxfmt": "latest",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-smartypants": "^3.0.2",
    "sharp": "^0.34.5",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "svelte-check": "^4.4.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
