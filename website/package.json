{
  "name": "llms-unplugged",
  "version": "1.5.0",
  "description": "Static website for LLMs Unplugged teaching resources",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANUcybernetics/llms-unplugged"
  },
  "homepage": "https://www.llmsunplugged.org",
  "author": "ANU School of Cybernetics",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "npx tsx scripts/copy-cli-templates.ts",
    "dev": "vitepress dev",
    "prebuild": "npx tsx scripts/copy-cli-templates.ts",
    "build": "vitepress build",
    "new": "npx tsx scripts/create-news-item.ts",
    "build:pdfs": "npx tsx scripts/build-lesson-pdfs.ts",
    "generate:image": "npx tsx scripts/generate-image.ts",
    "convert:avif": "npx tsx scripts/convert-images-to-avif.ts",
    "preview": "vitepress preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "vue-tsc --noEmit",
    "format": "oxfmt --ignore-path .gitignore --write '**/*.{js,mjs,ts,mts}' '**/*.vue' && prettier --write .",
    "format:check": "oxfmt --ignore-path .gitignore --check '**/*.{js,mjs,ts,mts}' '**/*.vue' && prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.0.0",
    "markdown-it": "^14.1.0",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "vite-plugin-checker": "^0.12.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-rss": "^0.4.2",
    "vitest": "^4.0.18",
    "vue": "^3.5.27",
    "vue-tsc": "^3.2.4"
  },
  "dependencies": {
    "mammoth": "^1.11.0",
    "markdown-it-footnote": "^4.0.0",
    "pdfjs-dist": "^5.4.624"
  }
}
