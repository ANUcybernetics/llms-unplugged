{
  "name": "llms-unplugged",
  "version": "2.0.0",
  "description": "Static website for LLMs Unplugged teaching resources",
  "homepage": "https://www.llmsunplugged.org",
  "license": "MIT",
  "author": "ANU School of Cybernetics",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANUcybernetics/llms-unplugged"
  },
  "type": "module",
  "scripts": {
    "predev": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "dev": "astro dev",
    "prebuild": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "build": "astro build",
    "build:a11y": "CHECK_A11Y=true pnpm run build",
    "preview": "astro preview",
    "new": "pnpm exec tsx scripts/create-news-item.ts",
    "pdf": "astromotion-pdf",
    "generate:image": "pnpm exec tsx scripts/generate-image.ts",
    "convert:avif": "pnpm exec tsx scripts/convert-images-to-avif.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . && stylelint 'src/**/*.css'",
    "lint:fix": "oxlint --fix . && stylelint --fix 'src/**/*.css'",
    "lint:css": "stylelint 'src/**/*.css'",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "format": "oxfmt --write '**/*.{js,ts,md,mdx,css,json,yaml,yml,svelte}' && prettier --write '**/*.astro'",
    "format:check": "oxfmt --check '**/*.{js,ts,md,mdx,css,json,yaml,yml,svelte}' && prettier --check '**/*.astro'",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@myriaddreamin/typst-ts-renderer": "0.7.0-rc2",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0-rc2",
    "@myriaddreamin/typst.ts": "0.7.0-rc2",
    "astro": "^7.1.0",
    "astro-theme-anu": "git+https://gitlab.anu.edu.au/u2548636/astro-theme-anu.git#astro-theme-anu@v0.9.1&path:/packages/astro-theme-anu",
    "astro-theme-university": "github:ANUcybernetics/astro-theme-university#v0.5.18",
    "astromotion": "github:ANUcybernetics/astromotion#v0.13.1",
    "lightningcss": "^1.32.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "svelte": "^5.56.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@e18e/eslint-plugin": "^0.5.1",
    "@iconify-json/iconoir": "^1.2.11",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "oxfmt": "latest",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer-core": "^25.3.0",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte-check": "^4.7.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  }
}
