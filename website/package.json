{
  "name": "llms-unplugged",
  "version": "2.0.0",
  "description": "Static website for LLMs Unplugged teaching resources",
  "homepage": "https://www.llmsunplugged.org",
  "license": "MIT",
  "author": "ANU School of Cybernetics",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANUcybernetics/llms-unplugged"
  },
  "type": "module",
  "scripts": {
    "predev": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "dev": "astro dev",
    "prebuild": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "build": "astro build",
    "build:a11y": "CHECK_A11Y=true pnpm run build",
    "preview": "astro preview",
    "new": "pnpm exec tsx scripts/create-news-item.ts",
    "pdf": "pnpm exec tsx scripts/deck-pdf.ts",
    "generate:image": "pnpm exec tsx scripts/generate-image.ts",
    "convert:avif": "pnpm exec tsx scripts/convert-images-to-avif.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . && stylelint 'src/**/*.css'",
    "lint:fix": "oxlint --fix . && stylelint --fix 'src/**/*.css'",
    "lint:css": "stylelint 'src/**/*.css'",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "format": "oxfmt --write '**/*.{js,ts,md,mdx,css,json,yaml,yml,svelte}' && prettier --write '**/*.astro'",
    "format:check": "oxfmt --check '**/*.{js,ts,md,mdx,css,json,yaml,yml,svelte}' && prettier --check '**/*.astro'",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.0",
    "astro": "^7.0.0",
    "astro-theme-anu": "git+https://gitlab.anu.edu.au/u2548636/astro-theme-anu.git#astro-theme-anu@v0.6.1&path:/packages/astro-theme-anu",
    "astromotion": "git+https://github.com/benswift/astromotion.git#v0.7.1",
    "lightningcss": "^1.32.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.0.227",
    "svelte": "^5.56.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@e18e/eslint-plugin": "^0.5.0",
    "@iconify-json/iconoir": "^1.2.11",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "oxfmt": "latest",
    "oxlint": "^1.69.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte-check": "^4.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.8.0"
}
