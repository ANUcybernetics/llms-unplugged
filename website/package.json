{
  "name": "llms-unplugged",
  "version": "2.0.0",
  "description": "Static website for LLMs Unplugged teaching resources",
  "homepage": "https://www.llmsunplugged.org",
  "license": "MIT",
  "author": "ANU School of Cybernetics",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANUcybernetics/llms-unplugged"
  },
  "type": "module",
  "scripts": {
    "predev": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "dev": "astro dev",
    "prebuild": "pnpm exec tsx scripts/copy-cli-templates.ts",
    "build": "astro build",
    "preview": "astro preview",
    "new": "pnpm exec tsx scripts/create-news-item.ts",
    "build:pdfs": "pnpm exec tsx scripts/build-lesson-pdfs.ts",
    "generate:image": "pnpm exec tsx scripts/generate-image.ts",
    "convert:avif": "pnpm exec tsx scripts/convert-images-to-avif.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "format": "oxfmt --write '**/*.{js,ts}' && prettier --write '**/*.{astro,svelte,md,mdx,css,json,yaml}'",
    "format:check": "oxfmt --check '**/*.{js,ts}' && prettier --check '**/*.{astro,svelte,md,mdx,css,json,yaml}'",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "dependencies": {
    "@animotion/core": "^1.2.2",
    "@astrojs/mdx": "^5.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/svelte": "^8.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.0",
    "astromotion": "github:benswift/astromotion",
    "lightningcss": "^1.32.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.624",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.0.0",
    "markdown-it": "^14.1.0",
    "oxfmt": "latest",
    "oxlint": "^1.48.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-svelte": "^3.0.0",
    "remark-smartypants": "^3.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
