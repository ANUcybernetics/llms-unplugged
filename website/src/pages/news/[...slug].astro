---
import { getCollection, render } from "astro:content";
import NewsLayout from "../../layouts/NewsLayout.astro";
import { findHeroImage } from "../../lib/hero-images";

export async function getStaticPaths() {
  const news = await getCollection("news", ({ data }) => data.published);
  return news.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

// Resolve through the asset pipeline so og:image points at the real
// (hashed) URL rather than a source path that 404s in production.
const ogImage = findHeroImage(`hero-news-${item.id}`);
---

<NewsLayout
  title={item.data.title}
  description={item.data.description}
  ogImage={ogImage}
  author={item.data.author}
  date={item.data.date}
>
  <Content />
</NewsLayout>
