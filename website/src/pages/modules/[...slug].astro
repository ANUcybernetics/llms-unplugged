---
import { getCollection, render } from "astro:content";
import ModuleLayout from "../../layouts/ModuleLayout.astro";
import { moduleHeroImage } from "../../lib/hero-images";

export async function getStaticPaths() {
  const modules = await getCollection("modules");
  return modules.map((module) => ({
    params: { slug: module.id },
    props: { module },
  }));
}

const { module } = Astro.props;
const { Content } = await render(module);

// Resolve through the asset pipeline so og:image points at the real
// (hashed) URL rather than a source path that 404s in production.
const ogImage = moduleHeroImage(module.id);

// Lessons (listed ones only) that run this module, for the "Used in" box.
const usedIn = (await getCollection("lessons"))
  .filter((l) => l.data.listed !== false && l.data.modules.includes(module.id))
  .toSorted((a, b) => a.data.order - b.data.order)
  .map((l) => ({ title: l.data.title, href: `/lessons/${l.id}/` }));
---

<ModuleLayout
  title={module.data.title}
  description={module.data.description}
  ogImage={ogImage}
  keyIdea={module.data.keyIdea}
  audience={module.data.audience}
  duration={module.data.duration}
  bases={module.data.bases}
  status={module.data.status}
  usedIn={usedIn}
  noindex={module.data.listed === false}
>
  <Content />
</ModuleLayout>
