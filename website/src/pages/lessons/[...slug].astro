---
import { getCollection, render } from "astro:content";
import LessonLayout from "../../layouts/LessonLayout.astro";
import { lessonHeroImage } from "../../lib/hero-images";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);

// Resolve through the asset pipeline so og:image points at the real
// (hashed) URL rather than a source path that 404s in production.
const ogImage = lessonHeroImage(lesson.id)?.src;
---

<LessonLayout
  title={lesson.data.title}
  description={lesson.data.description}
  ogImage={ogImage}
  keyIdea={lesson.data.keyIdea}
>
  <Content />
</LessonLayout>
