---
import { getCollection, render } from "astro:content";
import LessonLayout from "../../layouts/LessonLayout.astro";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);

const heroImageMap: Record<string, string> = {
  training: "grid-training",
  generation: "grid-generation",
  trigram: "grid-trigram",
};

const heroSlug = heroImageMap[lesson.id] ?? lesson.id;
const ogImage = `/assets/images/hero-${heroSlug}.avif`;
---

<LessonLayout
  title={lesson.data.title}
  description={lesson.data.description}
  ogImage={ogImage}
  keyIdea={lesson.data.keyIdea}
>
  <Content />
</LessonLayout>
