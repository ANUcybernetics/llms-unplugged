---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import fs from "node:fs";
import path from "node:path";
import { parseDeckFrontmatter } from "astromotion/src/meta.ts";

// Decks grouped by the lesson they back (from the lessons collection), so
// this page points visitors at the lesson pages --- which carry the timings,
// prep notes, and materials lists --- rather than at bare slide links.
const lessons = (await getCollection("lessons"))
  .filter((l) => l.data.listed !== false)
  .toSorted((a, b) => a.data.order - b.data.order);

const claimed = new Set(
  (await getCollection("lessons")).flatMap((l) =>
    l.data.decks.map((d) => d.slug),
  ),
);

// Any remaining decks (event one-offs, works in progress) still get listed
// unless their frontmatter says `listed: false`.
const decksDir = path.resolve("src/decks");
const others: Array<{ slug: string; title: string }> = [];

for (const entry of fs.readdirSync(decksDir, { withFileTypes: true })) {
  if (entry.isDirectory()) {
    const dirPath = path.join(decksDir, entry.name);
    for (const file of fs.readdirSync(dirPath)) {
      const match = file.match(/^(.+)\.deck\.mdx$/);
      if (!match) continue;
      const name = match[1];
      const raw = fs.readFileSync(path.join(dirPath, file), "utf-8");
      const { data } = parseDeckFrontmatter(raw, entry.name);
      if ((data as { listed?: boolean }).listed === false) continue;
      const slug = name === "slides" ? entry.name : `${entry.name}/${name}`;
      if (claimed.has(slug)) continue;
      others.push({ slug, title: data.title ?? name });
    }
  } else if (entry.isFile()) {
    const match = entry.name.match(/^(.+)\.deck\.mdx$/);
    if (!match) continue;
    const name = match[1];
    const raw = fs.readFileSync(path.join(decksDir, entry.name), "utf-8");
    const { data } = parseDeckFrontmatter(raw, name);
    if ((data as { listed?: boolean }).listed === false) continue;
    if (claimed.has(name)) continue;
    others.push({ slug: name, title: data.title ?? name });
  }
}
---

<PageLayout
  title="Slide decks"
  description="The slide decks behind the LLMs Unplugged lessons, with full presenter notes."
>
  <h1>Slide decks</h1>

  <p>
    Each deck belongs to a <a href="/lessons/">lesson</a>&mdash;start from the
    lesson page for timings, prep notes, and the materials list, then open the
    slides from there.
  </p>

  {
    lessons.map((lesson) => (
      <section>
        <h2>
          <a href={`/lessons/${lesson.id}/`}>{lesson.data.title}</a>
        </h2>
        <ul>
          {lesson.data.decks.map((deck) => (
            <li>
              <a href={`/decks/${deck.slug}/`}>{deck.label}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    others.length > 0 && (
      <section>
        <h2>Other decks</h2>
        <ul>
          {others.map((deck) => (
            <li>
              <a href={`/decks/${deck.slug}/`}>{deck.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</PageLayout>
