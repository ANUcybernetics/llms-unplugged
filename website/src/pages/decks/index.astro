---
import PageLayout from "../../layouts/PageLayout.astro";
import fs from "node:fs";
import path from "node:path";
import { parseDeckFrontmatter } from "astromotion/src/meta.ts";

const decksDir = path.resolve("src/decks");
const decks: Array<{ slug: string; title: string }> = [];

for (const entry of fs.readdirSync(decksDir, { withFileTypes: true })) {
  if (entry.isDirectory()) {
    const dirPath = path.join(decksDir, entry.name);
    for (const file of fs.readdirSync(dirPath)) {
      const match = file.match(/^(.+)\.deck\.mdx$/);
      if (!match) continue;
      const name = match[1];
      const raw = fs.readFileSync(path.join(dirPath, file), "utf-8");
      const { data } = parseDeckFrontmatter(raw, entry.name);
      if ((data as { hidden?: boolean }).hidden) continue;
      const slug = name === "slides" ? entry.name : `${entry.name}/${name}`;
      decks.push({ slug, title: data.title ?? name });
    }
  } else if (entry.isFile()) {
    const match = entry.name.match(/^(.+)\.deck\.mdx$/);
    if (!match) continue;
    const name = match[1];
    const raw = fs.readFileSync(path.join(decksDir, entry.name), "utf-8");
    const { data } = parseDeckFrontmatter(raw, name);
    if ((data as { hidden?: boolean }).hidden) continue;
    decks.push({ slug: name, title: data.title ?? name });
  }
}
---

<PageLayout title="Slide decks">
  <h1>Slide decks</h1>
  <ul>
    {
      decks.map((deck) => (
        <li>
          <a href={`/decks/${deck.slug}/`}>{deck.title}</a>
        </li>
      ))
    }
  </ul>
</PageLayout>
