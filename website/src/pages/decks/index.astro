---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import fs from "node:fs";
import path from "node:path";
import {
  parseDeckFrontmatter,
  type DeckFrontmatter,
} from "astromotion/src/meta.ts";

// Decks grouped by the lesson they back (from the lessons collection), so
// this page points visitors at the lesson pages --- which carry the timings,
// prep notes, and materials lists --- rather than at bare slide links.
//
// A deck's own frontmatter has the last word on whether it appears here, even
// when a listed lesson or talk claims it (a talk keeps its "as delivered"
// record decks in its list, linked from the talk page only). `listed: false`
// keeps a deck out of the indexes; `published: false` drops its route from
// production builds, so a link to it would be a link to nothing.
const decksDir = path.resolve("src/decks");
const decks = new Map<string, DeckFrontmatter>();

const readDeck = (file: string, slugFor: (name: string) => string) => {
  const match = path.basename(file).match(/^(.+)\.deck\.mdx$/);
  if (!match) return;
  const slug = slugFor(match[1]);
  const { data } = parseDeckFrontmatter(fs.readFileSync(file, "utf-8"), slug);
  decks.set(slug, data);
};

for (const entry of fs.readdirSync(decksDir, { withFileTypes: true })) {
  const entryPath = path.join(decksDir, entry.name);
  if (entry.isDirectory()) {
    for (const file of fs.readdirSync(entryPath)) {
      readDeck(path.join(entryPath, file), (name) =>
        name === "slides" ? entry.name : `${entry.name}/${name}`,
      );
    }
  } else if (entry.isFile()) {
    readDeck(entryPath, (name) => name);
  }
}

const hidden = (slug: string): boolean => {
  const data = decks.get(slug);
  return data?.listed === false || data?.published === false;
};

// Sessions with nothing visible to link are dropped rather than rendered as
// a bare heading.
const withVisibleDecks = <
  T extends { data: { decks: Array<{ slug: string }> } },
>(
  entries: T[],
): T[] =>
  entries
    .map((entry) => ({
      ...entry,
      data: {
        ...entry.data,
        decks: entry.data.decks.filter((d) => !hidden(d.slug)),
      },
    }))
    .filter((entry) => entry.data.decks.length > 0);

const lessons = withVisibleDecks(
  (await getCollection("lessons"))
    .filter((l) => l.data.listed !== false)
    .toSorted((a, b) => a.data.order - b.data.order),
);

const talks = withVisibleDecks(
  (await getCollection("talks"))
    .filter((t) => t.data.listed !== false)
    .toSorted((a, b) => a.data.order - b.data.order),
);

// A deck claimed by an unlisted lesson or talk falls through to "Other decks",
// so the deck's own flag governs whether it appears and the session only
// governs where.
const claimed = new Set(
  [...lessons, ...talks].flatMap((l) => l.data.decks.map((d) => d.slug)),
);

// Any remaining decks (event one-offs, works in progress) still get listed.
const others = [...decks]
  .filter(([slug]) => !claimed.has(slug) && !hidden(slug))
  .map(([slug, data]) => ({ slug, title: data.title ?? slug }))
  .toSorted((a, b) => a.slug.localeCompare(b.slug));
---

<PageLayout
  title="Slide decks"
  description="The slide decks behind the LLMs Unplugged lessons, with full presenter notes."
>
  <h1>Slide decks</h1>

  <p>
    Each deck belongs to a <a href="/lessons/">lesson</a>&mdash;start from the
    lesson page for timings, prep notes, and the materials list, then open the
    slides from there.
  </p>

  {
    lessons.map((lesson) => (
      <section>
        <h2>
          <a href={`/lessons/${lesson.id}/`}>{lesson.data.title}</a>
        </h2>
        <ul>
          {lesson.data.decks.map((deck) => (
            <li>
              <a href={`/decks/${deck.slug}/`}>{deck.label}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    talks.map((talk) => (
      <section>
        <h2>
          <a href={`/talks/${talk.id}/`}>{talk.data.title}</a> (talk)
        </h2>
        <ul>
          {talk.data.decks.map((deck) => (
            <li>
              <a href={`/decks/${deck.slug}/`}>{deck.label}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    others.length > 0 && (
      <section>
        <h2>Other decks</h2>
        <ul>
          {others.map((deck) => (
            <li>
              <a href={`/decks/${deck.slug}/`}>{deck.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</PageLayout>
