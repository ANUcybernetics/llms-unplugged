---
import { Image } from "astro:assets";
import Card from "astro-theme-university/components/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsCards from "../components/NewsCards.astro";
import GlossaryTerm from "../components/GlossaryTerm.astro";
import UpcomingSessions from "../components/UpcomingSessions.astro";
import heroIndex from "../assets/images/hero-index.avif";
import headshotBen from "../assets/images/headshot-ben-4.avif";
import heroHowModelsUnderstand from "../assets/images/hero-how-models-understand.avif";
import heroContact from "../assets/images/hero-contact.avif";
import doorTeach from "../assets/images/way-run-a-lesson.avif";
import doorWorkshop from "../assets/images/hero-workshops.avif";
import doorTryIt from "../assets/images/hero-fundamentals.avif";
import doorAttend from "../assets/images/hero-intro.avif";
---

<BaseLayout title="LLMs Unplugged">
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-name">LLMs Unplugged</span>
        <span class="hero-text"
          >Understand AI by building it from scratch, with pen, paper, and dice</span
        >
      </h1>
      <p class="hero-tagline">
        Hands-on teaching resources that demonstrate how large language models
        (LLMs) work&mdash;no computers or coding required.
      </p>
    </div>
    <div class="hero-image">
      <Image
        src={heroIndex}
        alt="Workshop participants around a table of paper tokens, reaching towards a glowing die"
        widths={[688, 1376]}
        sizes="(min-width: 960px) 590px, 100vw"
        loading="eager"
        fetchpriority="high"
        format="avif"
      />
    </div>
  </section>

  <UpcomingSessions />

  {
    /* a div, not <main>: the page already renders inside the theme's <main id="main"> */
  }
  <div class="home-content">
    <p class="intro-text">
      <em>LLMs Unplugged</em> is a set of hands-on teaching resources that demonstrate
      how large language models work&mdash;no computers or coding required. You count
      word patterns in a text, record them as tally marks on grid paper or physical
      piles of paper cutouts, then roll dice to generate new text from those patterns.
      After building a <GlossaryTerm id="language-model"
        >language model</GlossaryTerm
      > by hand, something clicks: you see that tools like <GlossaryTerm
        id="chatgpt">Claude and ChatGPT</GlossaryTerm
      > work using the same basic principles, just at a vastly larger scale.
    </p>

    <section class="doors">
      <h2>Where do you want to start?</h2>
      <div class="at-card-grid doors-grid">
        <Card
          href="/educators/"
          title="I'm teaching a class"
          image={doorTeach}
          imageAlt=""
        >
          <p class="card-description">
            Which lesson fits your year level and period length, what to print,
            where it sits in the curriculum, and accredited professional
            learning.
          </p>
        </Card>
        <Card
          href="/lessons/"
          title="I'm running a workshop or giving a talk"
          image={doorWorkshop}
          imageAlt=""
        >
          <p class="card-description">
            Ready-to-run sessions we've tested in real rooms, with slides,
            presenter notes, timings and materials lists&mdash;from a
            sixty-minute workshop to a fifteen-minute talk for a hall.
          </p>
        </Card>
        <Card
          href="/try-it/"
          title="I want to try it myself"
          image={doorTryIt}
          imageAlt=""
        >
          <p class="card-description">
            Twenty minutes on your own, with a pen, some paper and something
            random: tally the word pairs in a short text, then use them to write
            a new sentence.
          </p>
        </Card>
        <Card
          href="#next-sessions"
          title="I want to come to a session"
          image={doorAttend}
          imageAlt=""
        >
          <p class="card-description">
            We run open sessions at ANU in Canberra, and deliver workshops for
            schools, organisations and conferences. Book a place, or get in
            touch about hosting one.
          </p>
        </Card>
      </div>
      <p class="start-here">
        Not sure? Start with <a href="/lessons/my-first-language-model/"
          >My First Language Model</a
        >&mdash;the classic LLMs Unplugged lesson, in lengths from 60 minutes to
        two hours.
      </p>
    </section>

    <section>
      <h2>What's new in LLMs Unplugged?</h2>
      <NewsCards limit={2} />
      <p><a href="/news/">See all news &rarr;</a></p>
    </section>

    <div class="section-with-image">
      <div class="section-image">
        <Image
          src={heroHowModelsUnderstand}
          alt="Understanding AI through hands-on experience"
          loading="lazy"
          format="avif"
        />
      </div>
      <div class="section-content">
        <h2>Why does this matter?</h2>
        <p>
          Since <a href="https://chatgpt.com/">ChatGPT</a> arrived in November 2022,
          (most) everyone's using <GlossaryTerm id="language-model"
            >LLMs</GlossaryTerm
          >, yet most people have no real mental model of what's actually
          happening under the hood. Understanding how these systems
          work&mdash;not through metaphor or handwaving but through direct
          experience&mdash;is what we're all about. These resources don't tell
          you or your students what to think about the role of AI in society;
          they give you a grounding for having that discussion, informed by
          having done it yourself. No coding, no maths beyond counting and
          percentages, and it works from primary school to the boardroom. More
          in the <a href="/faq/">FAQ</a>.
        </p>
      </div>
    </div>

    <div class="section-with-image">
      <div class="section-image">
        <Image src={headshotBen} alt="Ben Swift" loading="lazy" format="avif" />
      </div>
      <div class="section-content">
        <h2>Who made this?</h2>
        <p>
          <em>LLMs Unplugged</em> is a <a
            href="https://cybernetics.anu.edu.au/cybernetic-studio/"
            >Cybernetic Studio</a
          > project created by <a href="https://benswift.me">Dr. Ben Swift</a> (PhD
          Computer Science, 2012) at the ANU School of Cybernetics. But if you're
          worried that <em>you'll</em> need a PhD in Computer Science to understand
          it, rest assured&mdash;the whole point of these resources is to demonstrate
          that you don't. There's more on the lineage, from CS Unplugged back to Shannon,
          on the <a href="/about/">about page</a>.
        </p>
      </div>
    </div>

    <div class="section-with-image">
      <div class="section-image">
        <Image
          src={heroContact}
          alt="Connecting and sharing ideas"
          loading="lazy"
          format="avif"
        />
      </div>
      <div class="section-content">
        <h2>Contact</h2>
        <p>
          If you have questions, success stories about using these materials, or
          would like to discuss adaptations or improvements you've made, get in
          touch at <a href="mailto:ben.swift@anu.edu.au">ben.swift@anu.edu.au</a
          >. If you'd like to hear about what cool stuff is going on at the
          School of Cybernetics, then sign up for the <a
            href="https://cybernetics.anu.edu.au/#subscribe-to-our-mailing-list-1"
            >mailing list</a
          >.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    max-width: 64rem;
    margin: 0 auto;
    /* Reduced bottom padding sets the gap above the upcoming-sessions box;
       .home-content's top padding mirrors it below for even spacing. */
    padding: 4rem 1.5rem 3rem;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding: 6rem 1.5rem 3rem;
    }
  }

  .hero-name {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .hero-title {
    margin: 0;
  }

  .hero-text {
    display: block;
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hero-tagline {
    font-size: 1.1rem;
    color: var(--at-text-secondary);
    margin: 1rem 0 1.5rem;
    line-height: 1.5;
  }

  /* single-column: image sits above the title, height-capped so the title
     stays above the fold */
  .hero-image {
    order: -1;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    max-height: 45vh;
    object-fit: cover;
  }

  @media (min-width: 960px) {
    .hero-image {
      order: 0;
    }

    .hero-image img {
      max-height: none;
    }
  }

  .home-content {
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .intro-text {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .doors {
    margin-bottom: 2rem;
  }

  /* two-up from tablet, four-up once there's room; never 3 + 1 */
  @media (min-width: 640px) {
    .doors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .doors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--at-text-secondary);
    margin: 0;
  }

  .start-here {
    margin: 1.5rem 0 0;
    font-size: 1.05rem;
  }
</style>
