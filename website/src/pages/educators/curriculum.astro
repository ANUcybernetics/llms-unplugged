---
import { getEntry, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Callout from "../../components/Callout.astro";

// Published straight from docs/curriculum-mapping.md (the docs collection in
// src/content.config.ts) so there is one copy to keep in sync --- see
// backlog task 027.
const doc = await getEntry("docs", "curriculum-mapping");
if (!doc) throw new Error("docs/curriculum-mapping.md is missing");
const { Content } = await render(doc);
---

<PageLayout
  title="Curriculum mapping"
  description="A draft mapping of the LLMs Unplugged modules to Australian Curriculum v9.0, including its AI elaborations, with coverage summaries by strand and three suggested programs."
>
  <h1>Mapping LLMs Unplugged to the Australian Curriculum</h1>

  <Callout type="warning" title="Draft, updated November 2026">
    <p>
      Every code and its wording was checked against ACARA's published curriculum in November 2026.
      The alignments have not yet been reviewed by an external curriculum expert, so treat them as a
      starting point, and <a href="/about/#get-in-touch">tell us</a> where you'd map differently.
    </p>
  </Callout>

  <Content />
</PageLayout>
