---
import { getCollection } from "astro:content";
import { EXTENSIONS, FUNDAMENTALS, type LessonSlug } from "../lib/sidebar";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const lessons = await getCollection("lessons");
const titleBySlug = new Map(lessons.map((l) => [l.id, l.data.title]));

function buildItems(slugs: readonly LessonSlug[]) {
  return slugs.map((slug) => {
    const title = titleBySlug.get(slug);
    if (!title) {
      throw new Error(
        `Sidebar references unknown lesson slug '${slug}'. Update src/lib/sidebar.ts or add the lesson file.`,
      );
    }
    return { text: title, link: `/lessons/${slug}` };
  });
}

const sections = [
  { title: "Fundamentals", items: buildItems(FUNDAMENTALS) },
  { title: "Extensions", items: buildItems(EXTENSIONS) },
];
---

<aside class="site-sidebar">
  {
    sections.map((section) => (
      <div class="sidebar-section">
        <h3 class="sidebar-heading">{section.title}</h3>
        <ul class="sidebar-items">
          {section.items.map(({ text, link }) => (
            <li>
              <a
                href={link}
                class:list={["sidebar-link", { active: currentPath === link }]}
              >
                {text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</aside>

<style>
  .site-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 1rem);
    width: var(--sidebar-width);
    max-height: calc(100vh - var(--nav-height) - 2rem);
    overflow-y: auto;
    padding: 1rem 0;
    flex-shrink: 0;
  }

  .sidebar-heading {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 1rem 0 0.5rem;
    padding: 0 0.75rem;
  }

  .sidebar-section:first-child .sidebar-heading {
    margin-top: 0;
  }

  .sidebar-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar-link {
    display: block;
    padding: 0.375rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .sidebar-link:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .sidebar-link.active {
    color: var(--color-brand);
    border-left-color: var(--color-brand);
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .site-sidebar {
      display: none;
    }
  }
</style>
