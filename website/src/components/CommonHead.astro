---
// Shared <head> content for every layout. BaseLayout and ModuleLayout used to
// carry diverging copies of this block (lesson pages silently lost analytics
// and the RSS link); keep all common head tags here.
//
// The canonical link and the og:/twitter: card tags used to live here too.
// They're the theme's job now --- see `socialImage` in site-config.ts and the
// per-page `socialImage` prop the layouts forward.
import Analytics from "./Analytics.astro";

interface Props {
  /**
   * Unlisted content (`listed: false`): keeps the page out of search engines
   * and the site's own Pagefind index (Pagefind honours robots noindex).
   */
  noindex?: boolean;
}

const { noindex = false } = Astro.props;
---

<meta name="theme-color" content="#be830e" />
{noindex && <meta name="robots" content="noindex" />}
<link rel="alternate" type="application/rss+xml" title="LLMs Unplugged RSS Feed" href="/feed.xml" />
<Analytics />
<script is:inline>
  // Set the grid/ledger/cutouts variant attribute before first paint.
  try {
    const v = localStorage.getItem("llms-unplugged-variant");
    document.documentElement.setAttribute(
      "data-variant",
      ["grid", "ledger", "cutouts"].includes(v) ? v : "grid",
    );
  } catch {
    document.documentElement.setAttribute("data-variant", "grid");
  }
</script>
