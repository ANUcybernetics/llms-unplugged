---
/**
 * A silent screen recording filling the slide, with a credit line along the
 * bottom. Reveal plays it when the slide comes up (data-autoplay) and pauses
 * it on the way out.
 */
interface Props {
  /** URL of the video: import the .mp4 in the deck and pass the import. */
  src: string;
  /** Credit and one-line description, shown over the bottom of the video. */
  caption: string;
}

const { src, caption } = Astro.props;
---

<figure class="demo-video">
  <video src={src} data-autoplay muted loop playsinline preload="auto"></video>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  /* Owns its geometry (a full-bleed layer), so it positions itself; the
     !important beats astromotion's `position: relative` on slide children. */
  .demo-video {
    position: absolute !important;
    inset: 0;
    margin: 0;
    background: var(--anu-black);
  }

  video {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  figcaption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 0.6rem 1.2rem;
    background: rgb(0 0 0 / 70%);
    color: var(--color-text-secondary);
    font-size: 1rem;
    text-align: start;
  }
</style>
