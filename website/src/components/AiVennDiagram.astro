---
// Staged-build Euler diagram for the "what is this about?" beat: AI contains
// ML contains LLMs, with named products inside the innermost circle. The AI
// circle is visible on arrival; each subsequent layer is a Reveal.js
// fragment, so the presenter narrates while clicking through the build.
---

<svg
  class="ai-venn"
  viewBox="0 0 960 540"
  role="img"
  aria-label="Nested circles showing that AI contains machine learning, which contains large language models, which include Claude, ChatGPT, Gemini and DeepSeek"
>
  <g class="ring ai">
    <circle cx="480" cy="290" r="235"></circle>
    <text x="480" y="115">AI</text>
  </g>
  <g class="fragment ring ml">
    <circle cx="480" cy="352" r="170"></circle>
    <text x="480" y="232">ML</text>
  </g>
  <g class="fragment ring llm">
    <circle cx="480" cy="410" r="108"></circle>
    <text x="480" y="342">LLMs</text>
  </g>
  <g class="fragment products">
    <text x="480" y="392">Claude</text>
    <text x="480" y="424">ChatGPT</text>
    <text x="480" y="456">Gemini</text>
    <text x="480" y="488">DeepSeek</text>
  </g>
</svg>

<style>
  .ai-venn {
    /* Full-bleed, like a ![bg] image: absolute positioning takes the svg out
       of the section's content-sized grid (where a percentage width would
       collapse against the 300x150 intrinsic-size auto track), and the
       960x540 viewBox scales edge-to-edge on the fixed 16:9 canvas. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ring circle {
    fill-opacity: 0.12;
    stroke-width: 3;
  }

  .ring text {
    text-anchor: middle;
    font-weight: 600;
    font-size: 34px;
  }

  /* Concentric warm-gold ramp: pale tint (AI, broadest) through soft gold
     (ML) to rich gold (LLMs), so the fills stack and intensify toward the
     gold core the talk is heading for. */
  .ai circle {
    fill: var(--anu-gold-tint);
    stroke: var(--anu-gold-tint);
  }

  .ai text {
    fill: var(--anu-gold-tint);
  }

  .ml circle {
    fill: var(--anu-gold-2);
    stroke: var(--anu-gold-2);
  }

  .ml text {
    fill: var(--anu-gold-2);
  }

  .llm circle {
    fill: var(--anu-gold);
    stroke: var(--anu-gold);
  }

  .llm text {
    fill: var(--anu-gold-tint);
  }

  .products text {
    text-anchor: middle;
    font-size: 24px;
    fill: var(--anu-white);
  }
</style>
