---
interface Props {
  type?: "info" | "tip" | "warning";
  title?: string;
}

const { type = "info", title } = Astro.props;

const defaultTitles: Record<string, string> = {
  info: "Info",
  tip: "Tip",
  warning: "Warning",
};

const resolvedTitle = title ?? defaultTitles[type];
---

<aside class:list={["at-callout", `at-callout--${type}`]} role="note">
  {resolvedTitle && <p class="callout-title">{resolvedTitle}</p>}
  <slot />
</aside>

<style>
  .callout-title {
    font-weight: 600;
    color: var(--at-accent);
    margin-block: 0 0.5rem;
  }
</style>
