---
// Plausible, for the site pages (via CommonHead) and the decks (via
// astromotion's `head` option). Custom events: "404" from the 404 page,
// "Generate PDF" from the tools page, "Slide View" from DeckHeadExtra; each
// needs a matching goal in the Plausible dashboard before it shows up there.
---

<link rel="preconnect" href="https://plausible.io" />
<script is:inline>
  // Queue plausible() calls made before the script arrives; it replays them.
  window.plausible =
    window.plausible ||
    function () {
      (window.plausible.q = window.plausible.q || []).push(arguments);
    };
  // The deck speaker view loads the deck again in two preview iframes, which
  // would each count as a pageview. Only a top-level page loads the script.
  if (window.top === window.self) {
    const script = document.createElement("script");
    script.dataset.domain = "www.llmsunplugged.org";
    script.src = "https://plausible.io/js/script.file-downloads.js";
    document.head.append(script);
  }
</script>
