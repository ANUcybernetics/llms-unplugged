---
import fs from "node:fs";
import path from "node:path";

/**
 * Shared "Using the slides" section for lesson pages. Every lesson ships a
 * browser-based slide deck with full presenter notes; this section explains
 * how to drive it, once, rather than on every lesson page.
 */
interface Deck {
  slug: string;
  label: string;
}

interface Props {
  decks: Deck[];
}

const { decks } = Astro.props;

// Pre-generated presenter guides (slides with interleaved speaker-notes
// pages) live in public/ next to the deck route. Regenerate with
// `pnpm exec astromotion-pdf <slug> public/decks/<slug>/presenter-guide.pdf --notes`.
// Resolved from the project root (not import.meta.url, which points at the
// bundled chunk in production builds).
const guideHref = (slug: string) => {
  const file = path.join(
    process.cwd(),
    "public",
    "decks",
    slug,
    "presenter-guide.pdf",
  );
  return fs.existsSync(file) ? `/decks/${slug}/presenter-guide.pdf` : null;
};

const anyGuide = decks.some((deck) => guideHref(deck.slug));
---

<h2 id="using-the-slides">Using the slides</h2>

{
  decks.length === 1 ? (
    <p>
      <a href={`/decks/${decks[0].slug}/`}>Open the slides</a> in your browser
      &mdash; there's nothing to install or download.
      {guideHref(decks[0].slug) && (
        <>
          There's also a{" "}
          <a href={guideHref(decks[0].slug)}>presenter guide (PDF)</a>
          &mdash; every slide followed by a page of its speaker notes &mdash; if
          you'd rather prepare away from the browser.
        </>
      )}
    </p>
  ) : (
    <>
      <ul>
        {decks.map((deck) => (
          <li>
            <a href={`/decks/${deck.slug}/`}>{deck.label}</a>
            {guideHref(deck.slug) && (
              <>
                {" "}
                (<a href={guideHref(deck.slug)}>presenter guide PDF</a>)
              </>
            )}
          </li>
        ))}
      </ul>
      {anyGuide && (
        <p>
          The presenter guides are PDFs with every slide followed by a page of
          its speaker notes&mdash;handy if you'd rather prepare away from the
          browser.
        </p>
      )}
    </>
  )
}

<p>
  The slides run in your browser, and every slide carries full presenter
  notes&mdash;what to say, what to watch for, and how long each part should
  take. A few keys worth knowing:
</p>

<ul>
  <li>
    <kbd>f</kbd> toggles fullscreen&mdash;do this before you start presenting
  </li>
  <li>
    <kbd>s</kbd> opens the speaker view in a separate window, with the presenter notes,
    a timer, and a preview of the next slide (drag it to your laptop screen and put
    the slides on the projector)
  </li>
  <li>
    <kbd>o</kbd> shows an overview of all slides, handy for skipping ahead if you're
    running short on time
  </li>
</ul>
