---
interface Props {
  /** Countdown length in minutes. */
  minutes?: number;
}

const { minutes = 10 } = Astro.props;

const totalSeconds = Math.max(1, Math.round(minutes * 60));
const mm = Math.floor(totalSeconds / 60);
const ss = totalSeconds % 60;
const initialLabel = `${mm}:${String(ss).padStart(2, "0")}`;

// SVG ring geometry (viewBox 0 0 100 100, r = 45).
const CIRCUMFERENCE = 2 * Math.PI * 45;
---

<div class="timer" data-timer data-total={totalSeconds}>
  <div class="row">
    <button type="button" class="adjust" data-adjust="-60" aria-label="Subtract one minute">
      &minus;1
    </button>

    <button type="button" class="dial" data-toggle aria-label="Start timer">
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <circle class="track" cx="50" cy="50" r="45"></circle>
        <circle
          class="progress"
          cx="50"
          cy="50"
          r="45"
          stroke-dasharray={CIRCUMFERENCE}
          stroke-dashoffset="0"></circle>
      </svg>
      <span class="time" data-time>{initialLabel}</span>
      <span class="hint" data-hint>start</span>
    </button>

    <button type="button" class="adjust" data-adjust="60" aria-label="Add one minute">
      +1
    </button>
  </div>

  <button type="button" class="reset" data-reset aria-label="Reset timer">reset</button>
</div>

<script>
  const CIRCUMFERENCE = 2 * Math.PI * 45;
  const MAX_MS = 99 * 60 * 1000;

  function format(ms: number): string {
    const s = Math.ceil(ms / 1000);
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
  }

  function initTimer(root: HTMLElement): void {
    if (root.dataset.timerReady) return;
    root.dataset.timerReady = "1";

    const totalMs = Math.max(1, Number(root.dataset.total) || 600) * 1000;
    const timeEl = root.querySelector<HTMLElement>("[data-time]")!;
    const hintEl = root.querySelector<HTMLElement>("[data-hint]")!;
    const progress = root.querySelector<SVGCircleElement>(".progress")!;
    const toggleBtn = root.querySelector<HTMLButtonElement>("[data-toggle]")!;

    let remaining = totalMs;
    let running = false;
    let endAt = 0;
    let interval: ReturnType<typeof setInterval> | null = null;

    const stopTick = () => {
      if (interval !== null) {
        clearInterval(interval);
        interval = null;
      }
    };

    const render = () => {
      const finished = remaining <= 0;
      timeEl.textContent = format(remaining);
      const fraction = Math.max(0, Math.min(1, remaining / totalMs));
      progress.style.strokeDashoffset = String(CIRCUMFERENCE * (1 - fraction));
      root.classList.toggle("running", running);
      root.classList.toggle("finished", finished);
      hintEl.textContent = finished ? "time's up" : running ? "pause" : "start";
      toggleBtn.setAttribute("aria-label", running ? "Pause timer" : "Start timer");
      root.setAttribute("aria-label", `${format(remaining)} remaining`);
    };

    const tick = () => {
      remaining = Math.max(0, endAt - Date.now());
      if (remaining <= 0) {
        running = false;
        stopTick();
      }
      render();
    };

    const start = () => {
      if (running || remaining <= 0) return;
      endAt = Date.now() + remaining;
      running = true;
      stopTick();
      interval = setInterval(tick, 200);
      render();
    };

    const pause = () => {
      if (!running) return;
      remaining = Math.max(0, endAt - Date.now());
      running = false;
      stopTick();
      render();
    };

    const reset = () => {
      stopTick();
      running = false;
      remaining = totalMs;
      render();
    };

    const adjust = (deltaMs: number) => {
      remaining = Math.max(0, Math.min(MAX_MS, remaining + deltaMs));
      if (running) endAt = Date.now() + remaining;
      render();
    };

    toggleBtn.addEventListener("click", () => (running ? pause() : start()));
    root
      .querySelector("[data-reset]")
      ?.addEventListener("click", reset);
    root.querySelectorAll<HTMLElement>("[data-adjust]").forEach((btn) => {
      btn.addEventListener("click", () =>
        adjust(Number(btn.dataset.adjust) * 1000),
      );
    });

    render();
  }

  const boot = () =>
    document
      .querySelectorAll<HTMLElement>("[data-timer]")
      .forEach(initTimer);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>

<style>
  .timer {
    --timer-size: 7.5em;
    --timer-done: #e2574c;

    /* Ring + controls use currentColor so they stay visible on both the dark
       activity slides and the gold `impact` slide (where a gold ring would
       vanish into the background). */
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4em;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .dial {
    position: relative;
    width: var(--timer-size);
    height: var(--timer-size);
    padding: 0;
    border: none;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .dial svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .track {
    fill: none;
    stroke: color-mix(in srgb, currentColor 22%, transparent);
    stroke-width: 6;
  }

  .progress {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.25s linear;
  }

  .time {
    grid-area: 1 / 1;
    font-size: 2em;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    transform: translateY(0.12em);
  }

  .hint {
    grid-area: 1 / 1;
    transform: translateY(2em);
    font-size: 0.6em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .adjust {
    border: 1px solid color-mix(in srgb, currentColor 45%, transparent);
    border-radius: 999px;
    background: none;
    color: inherit;
    cursor: pointer;
    width: 1.9em;
    height: 1.9em;
    font-size: 0.9em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
    transition:
      opacity 0.2s,
      background-color 0.2s;
  }

  .reset {
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
    font-size: 0.6em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.4;
    transition: opacity 0.2s;
  }

  .adjust:hover,
  .reset:hover,
  .dial:hover .hint {
    opacity: 0.9;
  }

  .adjust:hover {
    background: color-mix(in srgb, currentColor 15%, transparent);
  }

  .finished .progress {
    stroke: var(--timer-done);
  }

  .finished .time {
    color: var(--timer-done);
    animation: timer-pulse 1s ease-in-out infinite;
  }

  @keyframes timer-pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .progress {
      transition: none;
    }

    .finished .time {
      animation: none;
    }
  }
</style>
