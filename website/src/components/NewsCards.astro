---
import { getCollection } from "astro:content";
import Card from "astro-theme-anu/components/Card.astro";
import { findHeroImage } from "../lib/hero-images";

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

const allNews = (
  await getCollection("news", ({ data }) => data.published)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const news = limit ? allNews.slice(0, limit) : allNews;
---

<div class="at-card-grid at-card-grid--2">
  {
    news.map((item) => {
      const dateLabel = item.data.date.toLocaleDateString("en-AU", {
        year: "numeric",
        month: "long",
        day: "numeric",
      });
      return (
        <Card
          href={`/news/${item.id}`}
          title={item.data.title}
          image={findHeroImage(`hero-news-${item.id}`)}
        >
          <p class="card-description">{item.data.description}</p>
          <span class="card-meta">{dateLabel}</span>
        </Card>
      );
    })
  }
</div>

<style>
  .card-description {
    font-size: 0.85rem;
    color: var(--at-text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .card-meta {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--at-text-muted);
  }
</style>
