---
import { getGlossaryEntry } from "../lib/glossary";

interface Props {
  id: string;
}

const { id } = Astro.props;
const entry = getGlossaryEntry(id);

if (!entry) {
  throw new Error(`Glossary term not found: "${id}"`);
}

// One popover per term per page: the first use renders it, later uses of the
// same term render only a button targeting it. Astro.locals lives for one page
// render, so the set resets between pages.
const locals = Astro.locals as { glossaryPopovers?: Set<string> };
locals.glossaryPopovers ??= new Set();
const renderPopover = !locals.glossaryPopovers.has(id);
locals.glossaryPopovers.add(id);

const popoverId = `glossary-${id}`;

// This component renders inline inside a sentence, so its template is one
// node with the child tags kept adjacent: whitespace between top-level nodes
// or between the wrapper's children is emitted as text and shows up as a
// stray space next to the term. Styles live in src/styles/glossary.css and
// the positioning fallback in src/scripts/glossary-popover.ts for the same
// reason. The popover has no tooltip role because it contains a focusable
// link, and popover semantics already announce it. data-pagefind-ignore keeps
// the description out of the page's search index.
---

<span class="glossary-term-wrapper"
  ><button
    class="glossary-term"
    popovertarget={popoverId}
    popovertargetaction="toggle"
    aria-label={`${entry.term} (glossary term)`}
    ><slot>{entry.term}</slot></button
  >{
    renderPopover && (
      <span
        popover
        id={popoverId}
        class="glossary-popover"
        data-pagefind-ignore
      >
        <strong class="glossary-popover-term">{entry.term}</strong>
        <span class="glossary-popover-desc">{entry.description}</span>
        <a href={`/glossary/#${id}`} class="glossary-popover-link">
          View in glossary
        </a>
      </span>
    )
  }</span
>
