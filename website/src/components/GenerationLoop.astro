---
/**
 * A full-slide, wordless, endlessly generating picture of the language-model
 * loop: a row of tokens scrolls left, a fan of candidate next tokens opens at
 * its head (curve weight = probability), a highlight hops between them and
 * settles on a sampled one, and that token flies into the row before the next
 * fan opens. Each step samples afresh, so it never repeats exactly.
 *
 * `tools` turns the loop into an agent's: every few tokens the newest tile is
 * a tool call. A request runs down a wire, through a permission gate, to a
 * tool below the row, and the result comes back up as a tile of its own that
 * joins the row before generation carries on. Now and then the gate shuts and
 * a hollow "declined" tile comes back instead.
 *
 * `inject` (with `tools`) makes every result a foreign one: it lands in a
 * different colour, and the next few fans and picks carry that colour, fading
 * out over three tokens. No call is declined in this mode.
 *
 * Runs only while its slide is the current one and the tab is visible. With
 * prefers-reduced-motion it draws a single still frame.
 */
interface Props {
  tools?: boolean;
  inject?: boolean;
}

const { tools = false, inject = false } = Astro.props;
const uid = `gl-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class="generation-loop"
  data-generation-loop
  data-uid={uid}
  data-tools={tools ? "" : undefined}
  data-inject={tools && inject ? "" : undefined}
  aria-hidden="true"
>
  <svg viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid slice">
    <defs>
      <pattern id={`${uid}-lattice`} width="90" height="90" patternUnits="userSpaceOnUse">
        <circle cx="45" cy="45" r="36"></circle>
        <path d="M81 45H90M0 45H9M45 81V90M45 0V9"></path>
      </pattern>
      <linearGradient
        id={`${uid}-fade`}
        x1="0"
        x2="1280"
        y1="0"
        y2="0"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" stop-color="#000"></stop>
        <stop offset="0.38" stop-color="#fff"></stop>
      </linearGradient>
      <mask id={`${uid}-mask`} maskUnits="userSpaceOnUse" x="0" y="0" width="1280" height="720">
        <rect width="1280" height="720" fill={`url(#${uid}-fade)`}></rect>
      </mask>
      <filter id={`${uid}-glow`} x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="7" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <rect class="ground" width="1280" height="720"></rect>
    <rect class="lattice" width="1280" height="720" fill={`url(#${uid}-lattice)`}></rect>

    <g mask={`url(#${uid}-mask)`}>
      <g data-row></g>
    </g>
    <g data-station></g>
    <g data-fan></g>
    <circle class="head" data-head r="9" filter={`url(#${uid}-glow)`}></circle>
  </svg>
</div>

<script>
  import { el, fade, isLive, move, randInt, sleep } from "../lib/loopMotion";

  // Geometry, in viewBox units.
  const HEAD_X = 600; // right edge of the row
  const ROW_Y = 360; // row centre line
  const TILE_H = 60;
  const GAP = 16;
  const FAN_X = 900; // left edge of the candidate column
  const FAN_PITCH = 88; // vertical spacing between candidates
  const SHADES = 4; // fill classes .s0 .. .s3

  // The tool, in `tools` mode: a wire drops from the newest tile, through a
  // permission gate, to a box below the row.
  const WIRE_X = HEAD_X - 24; // inside the newest tile, whatever its width
  const WIRE_TOP = ROW_Y + TILE_H / 2 + 10;
  const GATE_Y = 475;
  const BOX_W = 168;
  const BOX_H = 108;
  const BOX_Y = 556; // top edge
  const BOX_CY = BOX_Y + BOX_H / 2;
  const TAINT_STEPS = 3; // tokens an injected result goes on colouring

  const tileWidth = () => randInt(4, 12) * 12;

  /** Probabilities for k candidates: skewed, like a real next-token row. */
  function weights(k: number): number[] {
    const raw = Array.from({ length: k }, () => (-Math.log(Math.random())) ** 1.6);
    const total = raw.reduce((a, b) => a + b, 0);
    return raw.map((w) => w / total);
  }

  function sample(ps: number[]): number {
    let r = Math.random();
    for (const [i, p] of ps.entries()) {
      r -= p;
      if (r <= 0) return i;
    }
    return ps.length - 1;
  }

  function init(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";

    const uid = root.dataset.uid!;
    const row = root.querySelector<SVGGElement>("[data-row]")!;
    const fan = root.querySelector<SVGGElement>("[data-fan]")!;
    const head = root.querySelector<SVGCircleElement>("[data-head]")!;
    const glow = `url(#${uid}-glow)`;
    const tools = "tools" in root.dataset;
    const inject = "inject" in root.dataset;
    const station = root.querySelector<SVGGElement>("[data-station]")!;

    head.setAttribute("cx", String(HEAD_X + GAP + 4));
    head.setAttribute("cy", String(ROW_Y));

    // The row lives in its own coordinates; `offset` slides it so its right
    // edge sits at HEAD_X.
    let rowEnd = 0;
    let offset = 0;

    const addToRow = (tile: SVGRectElement, width: number) => {
      tile.setAttribute("x", String(rowEnd + GAP));
      tile.setAttribute("y", String(ROW_Y - TILE_H / 2));
      tile.style.transform = "";
      row.append(tile);
      rowEnd += GAP + width;
    };

    // How many more tokens the last injected tool result will colour.
    let taint = 0;
    const tainted = () => (taint > 0 ? ` t${taint}` : "");

    const newTile = (width: number, parent: Element, extra = "") =>
      el(
        "rect",
        { width, height: TILE_H, rx: 14, class: `tile s${randInt(0, SHADES - 1)}${extra}` },
        parent,
      );

    /** Hand a tile sitting just right of the head to the row, and make room. */
    const land = async (tile: SVGRectElement, width: number) => {
      tile.removeAttribute("filter");
      tile.classList.remove("lit");
      tile.classList.add("landed");
      addToRow(tile, width);
      tile.style.opacity = "";
      const nextOffset = HEAD_X - rowEnd;
      await move(row, `translateX(${offset}px)`, `translateX(${nextOffset}px)`, 520);
      offset = nextOffset;
      setTimeout(() => tile.classList.remove("landed"), 900);

      // Drop tiles that have scrolled off the left.
      for (const old of [...row.children] as SVGRectElement[]) {
        const right = Number(old.getAttribute("x")) + Number(old.getAttribute("width")) + offset;
        if (right < -40) old.remove();
      }
    };

    // Start with a row already written, so the first frame (and a printed
    // one) isn't empty.
    while (rowEnd < HEAD_X + 200) {
      const width = tileWidth();
      addToRow(newTile(width, row), width);
    }
    offset = HEAD_X - rowEnd;
    row.style.transform = `translateX(${offset}px)`;

    const live = () => isLive(root);

    const drawFan = () => {
      const k = randInt(3, 6);
      const ps = weights(k);
      const top = ROW_Y - ((k - 1) * FAN_PITCH) / 2;
      const ox = HEAD_X + GAP + 4;
      const candidates = ps.map((p, i) => {
        const y = top + i * FAN_PITCH;
        const width = tileWidth();
        const curve = el(
          "path",
          {
            d: `M${ox} ${ROW_Y} C${ox + 110} ${ROW_Y} ${FAN_X - 120} ${y} ${FAN_X - 6} ${y}`,
            class: `curve${tainted()}`,
            "stroke-width": (1.5 + p * 12).toFixed(2),
          },
          fan,
        );
        const tile = newTile(width, fan, tainted());
        tile.setAttribute("x", String(FAN_X));
        tile.setAttribute("y", String(y - TILE_H / 2));
        tile.style.opacity = "0";
        curve.style.opacity = "0";
        return { p, y, width, curve, tile };
      });
      return candidates;
    };

    async function step() {
      const candidates = drawFan();

      // Open the fan, most likely first.
      const order = [...candidates.keys()].sort((a, b) => candidates[b].p - candidates[a].p);
      await Promise.all(
        order.map(async (i, rank) => {
          await sleep(rank * 70);
          const { p, curve, tile } = candidates[i];
          await Promise.all([fade(curve, 0.35 + p * 0.65, 380), fade(tile, 0.75 + p * 0.25, 380)]);
        }),
      );

      // Hop the highlight around, weighted, slowing to the sampled pick.
      const pick = sample(candidates.map((c) => c.p));
      const hops = randInt(5, 8);
      let lit = -1;
      for (let h = 0; h <= hops; h++) {
        const next = h === hops ? pick : sample(candidates.map((c) => c.p));
        if (lit >= 0) {
          candidates[lit].tile.classList.remove("lit");
          candidates[lit].curve.classList.remove("lit");
        }
        lit = next;
        candidates[lit].tile.classList.add("lit");
        candidates[lit].curve.classList.add("lit");
        await sleep(80 + (h / hops) ** 2 * 260);
      }

      const chosen = candidates[pick];
      chosen.tile.setAttribute("filter", glow);
      await sleep(260);

      // Everything else goes; the pick flies to the head of the row.
      await Promise.all([
        ...candidates
          .filter((c) => c !== chosen)
          .flatMap((c) => [fade(c.curve, 0, 320), fade(c.tile, 0, 320)]),
        fade(chosen.curve, 0, 500),
        move(
          chosen.tile,
          "translate(0px, 0px)",
          `translate(${HEAD_X + GAP - FAN_X}px, ${ROW_Y - chosen.y}px)`,
          560,
          "cubic-bezier(.5,0,.2,1)",
        ),
      ]);

      await land(chosen.tile, chosen.width);
      fan.replaceChildren();
      if (taint > 0) taint -= 1;
    }

    // The tool's furniture, drawn once and lit as each call passes through.
    let gate: SVGCircleElement | undefined;
    let box: SVGRectElement | undefined;
    let pulse: SVGCircleElement | undefined;
    if (tools) {
      el("path", { d: `M${WIRE_X} ${WIRE_TOP}V${BOX_Y}`, class: "wire" }, station);
      box = el(
        "rect",
        { x: WIRE_X - BOX_W / 2, y: BOX_Y, width: BOX_W, height: BOX_H, rx: 16, class: "box" },
        station,
      );
      // An envelope: the tool is something outside the model, like an inbox.
      const ex = WIRE_X - 44;
      const ey = BOX_CY - 28;
      el(
        "path",
        { d: `M${ex} ${ey}h88v56h-88zM${ex} ${ey}l44 30l44 -30`, class: "glyph" },
        station,
      );
      gate = el("circle", { cx: WIRE_X, cy: GATE_Y, r: 17, class: "gate" }, station);
      pulse = el("circle", { cx: WIRE_X, cy: WIRE_TOP, r: 10, class: "pulse" }, station);
    }

    /** The newest tile calls the tool; what comes back joins the row. */
    async function toolCall() {
      if (!gate || !box || !pulse) return;
      const caller = row.lastElementChild;
      caller?.classList.add("call");
      await sleep(420);

      // The request runs down the wire to the permission gate.
      const atGate = `translateY(${GATE_Y - WIRE_TOP}px)`;
      const declined = !inject && Math.random() < 0.25;
      pulse.style.opacity = "1";
      await move(pulse, "translateY(0px)", atGate, 420, "ease-in");
      gate.classList.add(declined ? "shut" : "open");
      await sleep(declined ? 620 : 240);

      if (!declined) {
        await move(pulse, atGate, `translateY(${BOX_Y - WIRE_TOP}px)`, 360, "ease-out");
        box.classList.add("lit");
        await sleep(560);
      }
      pulse.style.opacity = "0";
      pulse.style.transform = "";

      // The result (or the refusal) comes back as a tile and joins the row.
      const kind = declined ? "declined" : inject ? "foreign" : "result";
      const fromY = declined ? GATE_Y : BOX_CY;
      const width = tileWidth();
      const x = WIRE_X - width / 2;
      const tile = el(
        "rect",
        { x, y: fromY - TILE_H / 2, width, height: TILE_H, rx: 14, class: `tile ${kind}` },
        fan,
      );
      tile.style.opacity = "0";
      await fade(tile, 1, 220);
      await move(
        tile,
        "translate(0px, 0px)",
        `translate(${HEAD_X + GAP - x}px, ${ROW_Y - fromY}px)`,
        640,
        "cubic-bezier(.5,0,.2,1)",
      );
      gate.classList.remove("open", "shut");
      box.classList.remove("lit");
      await land(tile, width);
      if (kind === "foreign") taint = TAINT_STEPS;
    }

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const still = drawFan();
      const pick = sample(still.map((c) => c.p));
      still.forEach(({ p, curve, tile }, i) => {
        curve.style.opacity = String(0.35 + p * 0.65);
        tile.style.opacity = String(0.75 + p * 0.25);
        if (i === pick) {
          tile.classList.add("lit");
          curve.classList.add("lit");
        }
      });
      return;
    }

    void (async () => {
      let untilCall = randInt(2, 3);
      for (;;) {
        if (!live()) {
          await sleep(300);
          continue;
        }
        await step();
        if (!tools) continue;
        untilCall -= 1;
        if (untilCall > 0) continue;
        await toolCall();
        untilCall = randInt(2, 3);
      }
    })();
  }

  const boot = () => document.querySelectorAll<HTMLElement>("[data-generation-loop]").forEach(init);
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
</script>

<style>
  /* Owns its geometry: a full-bleed layer over the whole slide. */
  .generation-loop {
    position: absolute !important;
    inset: 0;
    margin: 0;
    background: var(--anu-black);

    --tool: var(--anu-teal-3);
    /* Outside the deck's palette on purpose: copper sits too near the gold
       tiles to read as foreign on a projector. */
    --foreign: oklch(64% 0.23 18deg);
  }

  svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .ground {
    fill: var(--anu-black);
  }

  .lattice {
    opacity: 0.9;
  }

  pattern :is(circle, path) {
    fill: none;
    stroke: #303030;
    stroke-width: 2;
  }

  :global(.generation-loop .tile) {
    stroke: var(--anu-black);
    stroke-width: 2;
    transition:
      fill 0.15s,
      stroke 0.15s;
  }

  :global(.generation-loop .s0) {
    fill: var(--anu-gold-tint);
  }

  :global(.generation-loop .s1) {
    fill: var(--anu-gold-2);
  }

  :global(.generation-loop .s2) {
    fill: hsl(from var(--anu-gold) h calc(s - 15) 58);
  }

  :global(.generation-loop .s3) {
    fill: var(--anu-gold);
  }

  :global(.generation-loop .tile.lit) {
    stroke: var(--anu-white);
    stroke-width: 3;
  }

  /* A just-landed token stays outlined in gold for a beat. */
  :global(.generation-loop .tile.landed) {
    stroke: var(--anu-gold-2);
    stroke-width: 3;
  }

  :global(.generation-loop .curve) {
    fill: none;
    stroke: var(--anu-gold);
    stroke-linecap: round;
    transition: stroke 0.15s;
  }

  :global(.generation-loop .curve.lit) {
    stroke: var(--anu-gold-tint);
    filter: drop-shadow(0 0 6px var(--anu-gold));
  }

  .head {
    fill: var(--anu-gold-2);
  }

  /* An injected result's colour carries into the next few tokens, fading. */
  :global(.generation-loop .tile:is(.t1, .t2, .t3)) {
    fill: color-mix(in oklab, var(--foreign) var(--taint), var(--anu-gold));
  }

  :global(.generation-loop .curve:is(.t1, .t2, .t3)) {
    stroke: color-mix(in oklab, var(--foreign) var(--taint), var(--anu-gold));
  }

  :global(.generation-loop .t3) {
    --taint: 100%;
  }

  :global(.generation-loop .t2) {
    --taint: 65%;
  }

  :global(.generation-loop .t1) {
    --taint: 35%;
  }

  /* The tile that asked for the tool keeps its ring in the row. */
  :global(.generation-loop .tile.call) {
    stroke: var(--tool);
    stroke-width: 5;
  }

  :global(.generation-loop .tile.result) {
    fill: var(--tool);
  }

  :global(.generation-loop .tile.foreign) {
    fill: var(--foreign);
  }

  :global(.generation-loop .tile.declined) {
    fill: var(--anu-black);
    stroke: var(--anu-white);
    stroke-width: 3;
    stroke-dasharray: 9 7;
  }

  :global(.generation-loop .wire) {
    fill: none;
    stroke: #8a8a8a;
    stroke-width: 4;
    stroke-dasharray: 3 11;
    stroke-linecap: round;
  }

  :global(.generation-loop :is(.box, .gate)) {
    fill: var(--anu-black);
    stroke: #b5b5b5;
    stroke-width: 4;
    transition:
      fill 0.2s,
      stroke 0.2s;
  }

  :global(.generation-loop .glyph) {
    fill: none;
    stroke: var(--anu-gold-tint);
    stroke-width: 4;
    stroke-linejoin: round;
  }

  :global(.generation-loop .box.lit) {
    stroke: var(--tool);
    filter: drop-shadow(0 0 10px var(--tool));
  }

  :global(.generation-loop[data-inject] .box.lit) {
    stroke: var(--foreign);
    filter: drop-shadow(0 0 10px var(--foreign));
  }

  :global(.generation-loop .gate.open) {
    fill: var(--tool);
    stroke: var(--tool);
  }

  :global(.generation-loop .gate.shut) {
    fill: var(--anu-white);
    stroke: var(--anu-white);
  }

  :global(.generation-loop .pulse) {
    fill: var(--anu-gold-2);
    opacity: 0;
  }
</style>
