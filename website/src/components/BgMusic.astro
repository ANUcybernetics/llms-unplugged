---
// Thin Astro wrapper that bundles src/scripts/bg-music.ts into the page.
//
// Lives as a component (not a bare <script> in the deck MDX) because the
// remark-deck-smartypants plugin processes text nodes inside MDX <script>
// blocks, mangling the import path's straight quotes into curly ones.
// Astro processes <script> in .astro files itself, bypassing that.
---

<script>
  import "../scripts/bg-music";
</script>
