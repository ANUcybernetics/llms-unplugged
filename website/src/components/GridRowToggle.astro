---
/**
 * Click-to-highlight rows on every BigramCountsTable in the deck.
 *
 * Drop `<GridRowToggle />` anywhere in a deck (once) and each row of every
 * bigram grid becomes toggleable with a click/pen-tap: one tap bands the row
 * gold, another clears it. Rows toggle independently, so several can be lit
 * at once; presenter shortcut C does NOT clear these (that's whiteboard ink)
 * --- tap again to clear. Built as an Astro component with a bundled script
 * because Svelte components don't hydrate inside astromotion decks.
 *
 * Note: with the whiteboard annotation surface up (⇧W) the pen draws ink and
 * taps never reach the table --- toggle rows before opening the surface.
 */
---

<script>
  const boot = () => {
    document
      .querySelectorAll<HTMLTableElement>("table.bigram-grid")
      .forEach((t) => t.classList.add("row-toggle"));
  };

  document.addEventListener("click", (e) => {
    const row = (e.target as Element | null)?.closest?.(
      "table.bigram-grid.row-toggle tbody tr",
    );
    row?.classList.toggle("row-picked");
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>

<style is:global>
  table.bigram-grid.row-toggle tbody tr {
    cursor: pointer;
  }

  /* Stronger than the component's prop-driven .active-row band (15%): this
     one is pointed at from across a hall. Applied to the row heading as well
     so the token lights up with its row. */
  table.bigram-grid.row-toggle tbody tr.row-picked td,
  table.bigram-grid.row-toggle tbody tr.row-picked th {
    background: color-mix(in srgb, var(--anu-gold) 32%, transparent);
  }

  /* In a picked row, each tally pings like a radar blip --- "these are the
     candidates". Deliberately dominant (usually only one row is lit at a
     time): on each beat the mark itself flashes bright while a ghost copy
     (::after, duplicating the mark via data-tally) blasts up to 3.2x and
     fades out, both in the tally's own colour, over a strong steady glow.
     Transforms/filters only, so nothing reflows and the band/borders stay
     put. */
  table.bigram-grid.row-toggle .tally {
    position: relative;
    display: inline-block;
  }

  table.bigram-grid.row-toggle tbody tr.row-picked .tally {
    text-shadow:
      0 0 0.3em currentColor,
      0 0 0.9em currentColor;
    animation: tally-flash 1.8s ease-out infinite;
  }

  table.bigram-grid.row-toggle tbody tr.row-picked .tally::after {
    content: attr(data-tally);
    position: absolute;
    inset: 0;
    text-align: center;
    animation: tally-ping 1.8s ease-out infinite;
  }

  /* Same duration keeps the flash and the ping on one synchronised beat. */
  @keyframes tally-flash {
    0% {
      filter: brightness(2.2);
    }

    35%,
    100% {
      filter: brightness(1);
    }
  }

  @keyframes tally-ping {
    0% {
      transform: scale(1);
      opacity: 1;
    }

    55%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    table.bigram-grid.row-toggle tbody tr.row-picked .tally {
      animation: none;
    }

    table.bigram-grid.row-toggle tbody tr.row-picked .tally::after {
      display: none;
    }
  }
</style>
