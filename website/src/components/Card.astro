---
interface Props {
  href: string;
  title: string;
  description?: string;
  image?: string;
  meta?: string;
}

const { href, title, description, image, meta } = Astro.props;
---

<a class="at-card" {href}>
  {
    image && (
      <div class="at-card-image-frame">
        <img src={image} alt="" class="at-card-image" loading="lazy" />
      </div>
    )
  }
  <div class="at-card-body">
    <h3 class="at-card-title">{title}</h3>
    {description && <p class="card-description">{description}</p>}
    {meta && <span class="card-meta">{meta}</span>}
  </div>
</a>

<style>
  .card-description {
    font-size: 0.85rem;
    color: var(--at-text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .card-meta {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--at-text-muted);
  }
</style>
