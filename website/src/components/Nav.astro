---
const navLinks = [
  { text: "Lessons", href: "/lessons/" },
  { text: "News", href: "/news/" },
  { text: "Glossary", href: "/glossary" },
  { text: "FAQ", href: "/faq" },
  { text: "About", href: "/about" },
];

const currentPath = Astro.url.pathname;

function isActive(currentPath: string, href: string): boolean {
  if (href.endsWith("/")) return currentPath.startsWith(href);
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="LLMs Unplugged home">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span class="nav-title">LLMs Unplugged</span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-label="Open menu"
      aria-controls="site-nav-menu"
      aria-expanded="false"
      data-nav-toggle
    >
      <svg
        class="nav-toggle-icon nav-toggle-icon--open"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
      <svg
        class="nav-toggle-icon nav-toggle-icon--close"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="6" y1="18" x2="18" y2="6"></line>
      </svg>
    </button>

    <ul id="site-nav-menu" class="nav-links" data-nav-menu>
      {
        navLinks.map(({ text, href }) => (
          <li>
            <a
              href={href}
              class:list={["nav-link", { active: isActive(currentPath, href) }]}
            >
              {text}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="https://github.com/ANUcybernetics/llms-unplugged"
      class="nav-github"
      aria-label="GitHub repository"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
        ></path>
      </svg>
    </a>
  </div>
</nav>

<script>
  // Mobile hamburger toggle. Kept in vanilla JS (no framework) since the nav
  // ships on every page and this is the simplest way to keep it zero-cost.
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-nav-menu]");

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.classList.toggle("nav-links--open", open);
  }

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    setOpen(!open);
  });

  // Close the menu when a link is tapped (so same-page anchor nav doesn't
  // leave a floating panel behind) and on Escape.
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
  }

  .nav-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    flex-shrink: 0;
  }

  .nav-title {
    font-size: 0.95rem;
  }

  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-link {
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-bg-soft);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--color-brand);
  }

  .nav-github {
    color: var(--color-text-secondary);
    transition: color 0.15s;
    flex-shrink: 0;
  }

  .nav-github:hover {
    color: var(--color-text);
  }

  /* Hamburger toggle: hidden on desktop, shown below the breakpoint. */
  .nav-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 0.25rem;
    margin-left: auto;
    color: var(--color-text-secondary);
    cursor: pointer;
    border-radius: 0.375rem;
  }

  .nav-toggle:hover {
    color: var(--color-text);
    background: var(--color-bg-soft);
  }

  .nav-toggle-icon {
    display: block;
  }

  .nav-toggle-icon--close {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-icon--open {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-icon--close {
    display: block;
  }

  @media (max-width: 640px) {
    .nav-inner {
      padding: 0 1rem;
      gap: 0.75rem;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-github {
      display: none;
    }

    .nav-links {
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
      /* Hidden by default; toggled open via .nav-links--open */
      display: none;
    }

    .nav-links.nav-links--open {
      display: flex;
    }

    .nav-link {
      padding: 0.75rem 1rem;
      font-size: 1rem;
      border-radius: 0.375rem;
    }
  }
</style>
