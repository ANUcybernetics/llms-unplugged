---
const navLinks = [
  { text: "Lessons", href: "/lessons/" },
  { text: "Glossary", href: "/glossary" },
  { text: "News", href: "/news/" },
  { text: "FAQ", href: "/faq" },
  { text: "About", href: "/about" },
];

const currentPath = Astro.url.pathname;
---

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="LLMs Unplugged home">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span class="nav-title">LLMs Unplugged</span>
    </a>
    <ul class="nav-links">
      {
        navLinks.map(({ text, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                "nav-link",
                { active: currentPath.startsWith(href) },
              ]}
            >
              {text}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="https://github.com/ANUcybernetics/llms-unplugged"
      class="nav-github"
      aria-label="GitHub repository"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
        ></path>
      </svg>
    </a>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
  }

  .nav-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    flex-shrink: 0;
  }

  .nav-title {
    font-size: 0.95rem;
  }

  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-link {
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-bg-soft);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--color-brand);
  }

  .nav-github {
    color: var(--color-text-secondary);
    transition: color 0.15s;
    flex-shrink: 0;
  }

  .nav-github:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .nav-title {
      display: none;
    }

    .nav-links {
      gap: 0;
    }

    .nav-link {
      padding: 0.375rem 0.5rem;
      font-size: 0.8rem;
    }
  }
</style>
