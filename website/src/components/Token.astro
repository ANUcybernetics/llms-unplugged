---
// Wired up in cutouts decks via an MDX `components` override on `code`, so
// inline backticks become Tokens. Default style is a coloured pill (the
// previous-word box on a paper cutout); pass `next` for the free-standing
// next-word style — plain coloured text, no box. Same hash-based palette
// (see src/lib/tokenColors.ts) for both, so a word wears its colour
// consistently whether boxed or free-standing.
import { tokenColorClass } from "../lib/tokenColors";

interface Props {
  next?: boolean;
}

const { next = false } = Astro.props;
const text = (await Astro.slots.render("default")).trim();
const styleClass = next ? "cutout-next-word" : "cutout-previous-word";
---

<span class:list={[styleClass, tokenColorClass(text)]}><slot /></span>
