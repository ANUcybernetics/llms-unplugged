---
import { getCollection } from "astro:content";

interface Props {
  /** "card" = prominent website box; each session links to its booking page.
      "plain" = deck slide: a static list, no links (booking is via the QR slide). */
  variant?: "card" | "plain";
}

const { variant = "card" } = Astro.props;
const isCard = variant === "card";

// Canberra/ACT shares the Australia/Sydney zone, so formatting the stored
// instants here handles the AEST/AEDT switch automatically.
const TZ = "Australia/Sydney";
const weekdayFmt = new Intl.DateTimeFormat("en-AU", {
  weekday: "long",
  timeZone: TZ,
});
const dateFmt = new Intl.DateTimeFormat("en-AU", {
  day: "numeric",
  month: "long",
  timeZone: TZ,
});
const timeFmt = new Intl.DateTimeFormat("en-AU", {
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
  timeZone: TZ,
});

const now = new Date();

const sessions = (await getCollection("events"))
  .map(({ data }) => ({
    ...data,
    end: new Date(data.start.getTime() + data.durationMinutes * 60_000),
  }))
  .filter((s) => s.end >= now)
  .sort((a, b) => a.start.getTime() - b.start.getTime());

const location = sessions[0]?.location;
const isEmpty = sessions.length === 0;
---

<div class:list={["upcoming-sessions", `upcoming-sessions--${variant}`]}>
  <div class="us-inner">
    <div class:list={["us-body", { "us-hidden": isEmpty }]}>
      <h2 class="us-heading">Next sessions</h2>
      <ul class="us-list" role="list">
        {
          sessions.map((s) => {
            const day = (
              <span class="us-day">
                {weekdayFmt.format(s.start)} {dateFmt.format(s.start)}
              </span>
            );
            const time = (
              <span class="us-time">
                {timeFmt.format(s.start)}&ndash;{timeFmt.format(s.end)}
              </span>
            );
            return (
              <li class="us-session" data-end={s.end.toISOString()}>
                {isCard ? (
                  <a
                    class="us-link"
                    href={s.bookingUrl}
                    target="_blank"
                    rel="noopener"
                  >
                    {day}
                    <span class="us-meta">
                      {time}
                      <span class="us-cta">
                        Book <span aria-hidden="true">&nearr;</span>
                      </span>
                    </span>
                  </a>
                ) : (
                  <span class="us-when">
                    {day} {time}
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
      {location && <p class="us-location">{location}</p>}
    </div>

    <p class:list={["us-empty", { "us-hidden": !isEmpty }]}>
      No public sessions are scheduled right now &mdash;
      <a href="/about/#get-in-touch">get in touch</a> to arrange one.
    </p>
  </div>
</div>

<style>
  /* Visibility utility — !important so it wins over the variant display rules
     below (which are more specific than a bare attribute selector would be). */
  .us-hidden {
    display: none !important;
  }

  .us-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ---- Website card variant ---- */
  .upcoming-sessions--card {
    /* width:100% is load-bearing: as a grid item of .at-main, margin:auto
       suppresses stretch, so without it the box shrinks to its content width
       instead of filling the column like the body text. */
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .upcoming-sessions--card .us-inner {
    /* Query target for the session grid below — switch to two columns once the
       card itself (not the viewport) is wide enough. */
    container-type: inline-size;
    padding: 1.5rem 1.75rem;
    background: var(--color-brand-soft);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .upcoming-sessions--card .us-heading {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--anu-gold);
  }

  .upcoming-sessions--card .us-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem 1.5rem;
  }

  @container (width >= 38rem) {
    .upcoming-sessions--card .us-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .upcoming-sessions--card .us-link {
    display: block;
    padding: 0.55rem 0.65rem;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .upcoming-sessions--card .us-link:hover,
  .upcoming-sessions--card .us-link:focus-visible {
    background: var(--lm-highlight-soft);
  }

  .upcoming-sessions--card .us-day {
    display: block;
    font-weight: 600;
    color: var(--color-text);
  }

  .upcoming-sessions--card .us-day::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.6rem;
    border-radius: 50%;
    background: var(--anu-gold);
    vertical-align: middle;
  }

  .upcoming-sessions--card .us-link:hover .us-day,
  .upcoming-sessions--card .us-link:focus-visible .us-day {
    color: var(--anu-gold);
  }

  .upcoming-sessions--card .us-meta {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-top: 0.1rem;
    /* Align the time under the date text, clearing the dot. */
    padding-left: 1.05rem;
  }

  .upcoming-sessions--card .us-time {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .upcoming-sessions--card .us-cta {
    color: var(--anu-gold);
    font-weight: 600;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .upcoming-sessions--card .us-location {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .upcoming-sessions--card .us-empty {
    margin: 0;
    color: var(--color-text-secondary);
  }

  /* Small screens: tighten the card padding and shrink the type a touch so the
     longer dates (e.g. "Wednesday 16 September") stay on one line. */
  @media (width <= 32rem) {
    .upcoming-sessions--card .us-inner {
      padding: 1.1rem 0.9rem;
    }

    .upcoming-sessions--card .us-link {
      padding: 0.45rem 0.3rem;
      font-size: 0.85rem;
    }

    .upcoming-sessions--card .us-day::before {
      margin-right: 0.5rem;
    }

    .upcoming-sessions--card .us-meta {
      padding-left: 0.95rem;
    }
  }

  /* ---- Deck plain variant ---- */
  .upcoming-sessions--plain .us-session {
    margin: 0.25em 0;
  }

  .upcoming-sessions--plain .us-day {
    font-weight: 700;
  }

  .upcoming-sessions--plain .us-time {
    margin-left: 0.5em;
    color: var(--anu-gold);
    font-variant-numeric: tabular-nums;
  }

  .upcoming-sessions--plain .us-location {
    margin-top: 0.6em;
  }
</style>

<script>
  // Hide sessions that have already finished, so the box stays correct between
  // (potentially infrequent) static rebuilds. Runs once over every instance.
  const now = Date.now();
  for (const root of document.querySelectorAll(".upcoming-sessions")) {
    let visible = 0;
    for (const li of root.querySelectorAll<HTMLElement>(".us-session")) {
      const end = Date.parse(li.dataset.end ?? "");
      const past = Number.isFinite(end) && end < now;
      li.classList.toggle("us-hidden", past);
      if (!past) visible += 1;
    }
    if (visible === 0) {
      root.querySelector(".us-body")?.classList.add("us-hidden");
      root.querySelector(".us-empty")?.classList.remove("us-hidden");
    }
  }
</script>
