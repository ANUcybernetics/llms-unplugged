---
import Token from "./Token.astro";

interface Props {
  tokens: string;
  ngram?: number;
  columns?: number;
}

const { tokens: tokenString, ngram = 2, columns = 1 } = Astro.props;

const tokenList = tokenString.trim().split(/\s+/).filter(Boolean);
const contextSize = ngram - 1;

interface CutoutEntry {
  previousWords: string[];
  nextWords: string[];
}

const entries: CutoutEntry[] = [];
const indexByPreviousWords = new Map<string, number>();

for (let i = 0; i < tokenList.length - contextSize; i++) {
  const previousWords = tokenList.slice(i, i + contextSize);
  const nextWord = tokenList[i + contextSize];
  const key = previousWords.join("\0");
  let idx = indexByPreviousWords.get(key);
  if (idx === undefined) {
    idx = entries.length;
    indexByPreviousWords.set(key, idx);
    entries.push({ previousWords, nextWords: [] });
  }
  entries[idx].nextWords.push(nextWord);
}

const rowCount = Math.ceil(entries.length / columns);
const rows: (CutoutEntry | null)[][] = Array.from(
  { length: rowCount },
  (_, r) =>
    Array.from(
      { length: columns },
      (_, c) => entries[c * rowCount + r] ?? null,
    ),
);
---

<div class="lm-cutouts">
  <table>
    <thead>
      <tr>
        {
          Array.from({ length: columns }).map(() => (
            <>
              <th>{contextSize > 1 ? "Previous words" : "Previous word"}</th>
              <th>Next words</th>
            </>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell) =>
              cell ? (
                <>
                  <td>
                    {cell.previousWords.map((p, i) => (
                      <>
                        {i > 0 && " "}
                        <Token>{p}</Token>
                      </>
                    ))}
                  </td>
                  <td>
                    {cell.nextWords.map((t, i) => (
                      <>
                        {i > 0 && " "}
                        <Token next>{t}</Token>
                      </>
                    ))}
                  </td>
                </>
              ) : (
                <>
                  <td />
                  <td />
                </>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
