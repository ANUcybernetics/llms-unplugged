---
interface Props {
  tokens: string;
  ngram?: number;
  columns?: number;
}

const { tokens: tokenString, ngram = 2, columns = 1 } = Astro.props;

const tokenList = tokenString.trim().split(/\s+/).filter(Boolean);
const contextSize = ngram - 1;

const cutouts = new Map<string, string[]>();

for (let i = 0; i < tokenList.length - contextSize; i++) {
  const label = tokenList.slice(i, i + contextSize).join(" ");
  const token = tokenList[i + contextSize];
  if (!cutouts.has(label)) {
    cutouts.set(label, []);
  }
  cutouts.get(label)!.push(token);
}

const entries = [...cutouts.entries()];
const rowCount = Math.ceil(entries.length / columns);
const rows: ([string, string[]] | null)[][] = Array.from(
  { length: rowCount },
  (_, r) =>
    Array.from({ length: columns }, (_, c) => entries[c * rowCount + r] ?? null),
);
---

<div class="lm-cutouts">
  <table>
    <thead>
      <tr>
        {
          Array.from({ length: columns }).map(() => (
            <>
              <th>Prefix label</th>
              <th>Following tokens</th>
            </>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell) =>
              cell ? (
                <>
                  <td>{cell[0]}</td>
                  <td>
                    {cell[1].map((t, i) => (
                      <>
                        {i > 0 && " "}
                        <code>{t}</code>
                      </>
                    ))}
                  </td>
                </>
              ) : (
                <>
                  <td />
                  <td />
                </>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
