---
import { tokenColorClass } from "../lib/tokenColors";

interface Props {
  tokens: string;
  ngram?: number;
  columns?: number;
}

const { tokens: tokenString, ngram = 2, columns = 1 } = Astro.props;

const tokenList = tokenString.trim().split(/\s+/).filter(Boolean);
const contextSize = ngram - 1;

interface CutoutEntry {
  prefix: string[];
  tokens: string[];
}

const entries: CutoutEntry[] = [];
const indexByPrefix = new Map<string, number>();

for (let i = 0; i < tokenList.length - contextSize; i++) {
  const prefix = tokenList.slice(i, i + contextSize);
  const token = tokenList[i + contextSize];
  const key = prefix.join("\0");
  let idx = indexByPrefix.get(key);
  if (idx === undefined) {
    idx = entries.length;
    indexByPrefix.set(key, idx);
    entries.push({ prefix, tokens: [] });
  }
  entries[idx].tokens.push(token);
}

const rowCount = Math.ceil(entries.length / columns);
const rows: (CutoutEntry | null)[][] = Array.from({ length: rowCount }, (_, r) =>
  Array.from({ length: columns }, (_, c) => entries[c * rowCount + r] ?? null),
);
---

<div class="lm-cutouts">
  <table>
    <thead>
      <tr>
        {
          Array.from({ length: columns }).map(() => (
            <>
              <th>Prefix</th>
              <th>Following tokens</th>
            </>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell) =>
              cell ? (
                <>
                  <td>
                    {cell.prefix.map((p, i) => (
                      <>
                        {i > 0 && " "}
                        <span class:list={["cutout-prefix", tokenColorClass(p)]}>
                          {p}
                        </span>
                      </>
                    ))}
                  </td>
                  <td>
                    {cell.tokens.map((t, i) => (
                      <>
                        {i > 0 && " "}
                        <span class:list={["cutout-text", tokenColorClass(t)]}>
                          {t}
                        </span>
                      </>
                    ))}
                  </td>
                </>
              ) : (
                <>
                  <td />
                  <td />
                </>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
