---
import { getCollection } from "astro:content";
import Card from "astro-theme-university/components/Card.astro";
import { lessonHeroImage } from "../lib/hero-images";
import { type Lesson, lessonsInTopic } from "../lib/lessons";
import type { Topic } from "../lib/topics";

interface Props {
  /** Explicit lesson slugs (may span topics), rendered in `order`. */
  lessons?: string[];
  /** A topic: renders that topic's listed lessons, in `order`. */
  topic?: Topic;
}

const { lessons: filterSlugs, topic } = Astro.props;

let cards: Lesson[];
if (topic) {
  cards = await lessonsInTopic(topic);
} else if (filterSlugs) {
  const all = (await getCollection("lessons")).toSorted(
    (a, b) => a.data.order - b.data.order,
  );
  cards = all.filter((l) => filterSlugs.includes(l.id));
} else {
  cards = [];
}
---

<div class="at-card-grid at-card-grid--2">
  {
    cards.map((lesson) => (
      <Card
        href={`/lessons/${lesson.id}`}
        title={lesson.data.title}
        image={lessonHeroImage(lesson.id)}
      >
        <p class="card-description">{lesson.data.description}</p>
      </Card>
    ))
  }
</div>

<style>
  .card-description {
    font-size: 0.85rem;
    color: var(--at-text-secondary);
    margin: 0;
    line-height: 1.4;
  }
</style>
