---
import { getCollection } from "astro:content";
import Card from "astro-theme-university/components/Card.astro";
import { moduleHeroImage } from "../lib/hero-images";
import { type Module, modulesInTopic } from "../lib/modules";
import { moduleStatusLabels } from "../lib/status";
import type { Topic } from "../lib/topics";

interface Props {
  /** Explicit module slugs (may span topics), rendered in `order`. */
  modules?: string[];
  /** A topic: renders that topic's listed modules, in `order`. */
  topic?: Topic;
}

const { modules: filterSlugs, topic } = Astro.props;

let cards: Module[];
if (topic) {
  cards = await modulesInTopic(topic);
} else if (filterSlugs) {
  const all = (await getCollection("modules")).toSorted(
    (a, b) => a.data.order - b.data.order,
  );
  cards = all.filter((m) => filterSlugs.includes(m.id));
} else {
  cards = [];
}
---

<div class="at-card-grid at-card-grid--2">
  {
    cards.map((module) => (
      <Card
        href={`/modules/${module.id}/`}
        title={module.data.title}
        image={moduleHeroImage(module.id)}
      >
        <p class="card-description">{module.data.description}</p>
        <p class="card-badges">
          {module.data.audience} &middot; {module.data.duration} &middot;{" "}
          {module.data.bases.join(", ")} &middot;{" "}
          <span class={`status-badge status-${module.data.status}`}>
            {moduleStatusLabels[module.data.status]}
          </span>
        </p>
      </Card>
    ))
  }
</div>

<style>
  .card-description {
    font-size: 0.85rem;
    color: var(--at-text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .card-badges {
    font-size: 0.8rem;
    color: var(--at-text-secondary);
    margin: 0.5rem 0 0;
  }
</style>
