---
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Callout from "../components/Callout.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: ImageMetadata | string;
  kind?: "workshop" | "talk";
  audience: string;
  duration: string;
  flavour: "grid" | "cutouts" | "sheets" | "ledger";
  noindex?: boolean;
  /** URL of the lesson's printout pack (see packUrl in lib/pdfs.ts). */
  pack?: string | null;
}

const {
  title,
  description,
  ogImage,
  kind = "workshop",
  audience,
  duration,
  flavour,
  noindex,
  pack,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  noindex={noindex}
>
  <div class="content-container">
    <article class="prose">
      <h1>{title}</h1>
      <ul class="page-meta">
        <li><strong>Audience</strong> {audience}</li>
        <li><strong>Duration</strong> {duration}</li>
        <li>
          <strong>{kind === "talk" ? "Format" : "Flavour"}</strong>
          {flavour}
        </li>
      </ul>
      {pack && <Callout type="tip" title="Printouts">
        <p>
          <a href={pack}>Download the printouts (zip)</a> for every length of this lesson. The
          README inside says which length needs what.
        </p>
      </Callout>}
      <slot />
    </article>
  </div>
</BaseLayout>
