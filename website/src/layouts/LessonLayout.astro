---
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Callout from "../components/Callout.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: ImageMetadata | string;
  kind?: "workshop" | "talk";
  audience: string;
  duration: string;
  flavour: "grid" | "cutouts" | "sheets" | "ledger";
  noindex?: boolean;
  /** URL of the lesson's printout pack (see packUrl in lib/pdfs.ts). */
  pack?: string | null;
  /** The lesson's decks; labels end in the length, e.g. "... (60 min)". */
  decks?: Array<{ slug: string; label: string }>;
}

const {
  title,
  description,
  ogImage,
  kind = "workshop",
  audience,
  duration,
  flavour,
  noindex,
  pack,
  decks = [],
} = Astro.props;

// "My First Language Model (60 min)" -> "60 min"
const shortLabel = (label: string) => label.match(/\(([^)]+)\)\s*$/)?.[1] ?? label;

// One string, so no formatter-inserted whitespace lands before the comma.
const deckLinks = decks
  .map(
    (deck) =>
      `<a href="/decks/${deck.slug}/">${decks.length === 1 ? deck.label : shortLabel(deck.label)}</a>`,
  )
  .join(" · ");
const slidesHtml =
  decks.length > 0 &&
  `${decks.length === 1 ? "Open the slides" : "Slides"}: ${deckLinks}, with full presenter notes (more under <a href="#using-the-slides">using the slides</a>).`;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  noindex={noindex}
>
  <div class="content-container">
    <article class="prose">
      <h1>{title}</h1>
      <ul class="page-meta">
        <li><strong>Audience</strong> {audience}</li>
        <li><strong>Duration</strong> {duration}</li>
        <li>
          <strong>{kind === "talk" ? "Format" : "Flavour"}</strong>
          {flavour}
        </li>
      </ul>
      {(decks.length > 0 || pack) && <Callout
        type="tip"
        title={
          decks.length > 0 && pack
            ? "Slides and printouts"
            : decks.length > 0
              ? "Slides"
              : "Printouts"
        }
      >
        {slidesHtml && <p set:html={slidesHtml} />}
        {pack && <p>
          <a href={pack}>Download the printouts (zip)</a> for every length of this lesson. The
          README inside says which length needs what.
        </p>}
      </Callout>}
      <slot />
    </article>
  </div>
</BaseLayout>
