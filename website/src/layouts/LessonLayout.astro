---
import SidebarLayout from "astro-theme-anu/layouts/SidebarLayout.astro";
import CommonHead from "../components/CommonHead.astro";
import { siteConfig, themeLogo, footerOverrides } from "../site-config";
import { getLessonSidebar } from "../lib/lesson-sidebar";
import faviconAsset from "../assets/favicon.svg";
import "../styles/global.css";
import "../styles/widgets.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  keyIdea?: string;
}

const { title, description, ogImage, keyIdea } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") + "/";
const sidebar = await getLessonSidebar();
const slug = currentPath.split("/").filter(Boolean).pop();
---

<SidebarLayout
  title={title}
  description={description}
  sidebar={sidebar}
  currentPath={currentPath}
  sidebarLabel="Lessons"
  favicon={faviconAsset}
  logo={themeLogo}
  logoDark={themeLogo}
  {...siteConfig}
  {...footerOverrides}
>
  <Fragment slot="head">
    <CommonHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType="article"
    />
  </Fragment>

  <div class="print-wordmark">
    LLMs Unplugged (c) Ben Swift, Cybernetic Studio - CC BY-NC-SA 4.0
  </div>
  <div class="prose">
    {
      keyIdea && (
        <p class="lesson-key-idea">
          <strong>Key idea:</strong> {keyIdea}
        </p>
      )
    }
    <slot />
  </div>
  <div class="edit-link">
    <a
      href={`https://github.com/ANUcybernetics/llms-unplugged/edit/main/website/src/content/lessons/${slug}.mdx`}
    >
      Edit this page on GitHub
    </a>
  </div>
</SidebarLayout>

<style>
  .lesson-key-idea {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border-inline-start: 4px solid var(--at-accent);
    background: var(--at-accent-soft);
    border-radius: 0 0.25rem 0.25rem 0;
    font-size: 1.05rem;
  }

  .edit-link {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--at-divider);
    font-size: 0.875rem;
  }
</style>
