---
import ThemeBaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import CommonHead from "../components/CommonHead.astro";
import { siteConfig, themeLogo, footerOverrides } from "../site-config";
import faviconAsset from "../assets/favicon.svg";
import "../styles/global.css";
import "../styles/widgets.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = "Hands-on teaching resources that demonstrate how large language models work. No computers or coding required.",
  ogImage,
  ogType,
  noindex,
} = Astro.props;

const fullTitle =
  title === "LLMs Unplugged" ? title : `${title} | LLMs Unplugged`;
---

<ThemeBaseLayout
  title={fullTitle}
  description={description}
  favicon={faviconAsset}
  logo={themeLogo}
  logoDark={themeLogo}
  {...siteConfig}
  {...footerOverrides}
>
  <Fragment slot="head">
    <CommonHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
  </Fragment>

  <div class="print-wordmark" data-pagefind-ignore>
    LLMs Unplugged (c) Ben Swift, Cybernetic Studio - CC BY-NC-SA 4.0
  </div>
  {
    /* data-pagefind-body scopes the Pagefind index to page content (skipping
       nav/footer chrome); because at least one page carries it, every page
       without it --- unlisted content, decks, redirect stubs --- is excluded
       from search entirely. */
  }
  <div class="pagefind-scope" data-pagefind-body={noindex ? undefined : ""}>
    <slot />
  </div>
</ThemeBaseLayout>

<style>
  /* The theme's .at-main is a subgrid that places its direct children via
     `.at-main > * { grid-column: content }`. A `display: contents` wrapper
     here would drop out of layout and leave the page sections as at-main
     grid items that no longer match that `> *` rule, collapsing them into
     the narrow gutter track. Instead the wrapper participates as a
     transparent single-track subgrid (the same trick the theme uses for
     `astro-island`): the wrapper itself lands in the content column and
     its children auto-flow into that track. */
  .pagefind-scope {
    display: grid;
    grid-template-columns: subgrid;
  }
</style>
