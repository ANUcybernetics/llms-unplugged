---
import type { ImageMetadata } from "astro";
import ThemeBaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import CommonHead from "../components/CommonHead.astro";
import { siteConfig, themeLogo, footerOverrides } from "../site-config";
import faviconAsset from "../assets/favicon.svg";
import "../styles/global.css";
import "../styles/widgets.css";

interface Props {
  title: string;
  description?: string;
  /** Link-preview card for this page; falls back to the site-wide default. */
  ogImage?: ImageMetadata | string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

// Page artwork comes from a glob with no alt text of its own, so the
// site-wide `socialImageAlt` applies only to the site-wide card.
const {
  title,
  description = "Hands-on teaching resources that demonstrate how large language models work. No computers or coding required.",
  ogImage,
  ogType,
  noindex,
} = Astro.props;

const fullTitle =
  title === "LLMs Unplugged" ? title : `${title} | LLMs Unplugged`;
---

{
  /* data-pagefind-body on the theme's <main> scopes the Pagefind index to
     page content (skipping nav/footer chrome); because at least one page
     carries it, every page without it --- unlisted content, decks, redirect
     stubs --- is excluded from search entirely. Set via mainAttrs rather
     than a wrapper element so the theme's .at-main subgrid placement of
     page sections is undisturbed. */
}
<ThemeBaseLayout
  title={fullTitle}
  description={description}
  favicon={faviconAsset}
  logo={themeLogo}
  logoDark={themeLogo}
  mainAttrs={noindex ? {} : { "data-pagefind-body": "" }}
  {...siteConfig}
  {...footerOverrides}
  socialImage={ogImage ?? siteConfig.socialImage}
  socialImageAlt={ogImage ? undefined : siteConfig.socialImageAlt}
  socialType={ogType}
>
  <Fragment slot="head">
    <CommonHead noindex={noindex} />
  </Fragment>

  <div class="print-wordmark" data-pagefind-ignore>
    LLMs Unplugged (c) Ben Swift, Cybernetic Studio - CC BY-NC-SA 4.0
  </div>
  <slot />
</ThemeBaseLayout>
