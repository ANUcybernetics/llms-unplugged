---
import ThemeBaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import CommonHead from "../components/CommonHead.astro";
import { siteConfig, themeLogo, footerOverrides } from "../site-config";
import faviconAsset from "../assets/favicon.svg";
import "../styles/global.css";
import "../styles/widgets.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = "Hands-on teaching resources that demonstrate how large language models work. No computers or coding required.",
  ogImage,
  ogType,
} = Astro.props;

const fullTitle =
  title === "LLMs Unplugged" ? title : `${title} | LLMs Unplugged`;
---

<ThemeBaseLayout
  title={fullTitle}
  description={description}
  favicon={faviconAsset}
  logo={themeLogo}
  logoDark={themeLogo}
  {...siteConfig}
  {...footerOverrides}
>
  <Fragment slot="head">
    <CommonHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
    />
  </Fragment>

  <div class="print-wordmark" data-pagefind-ignore>
    LLMs Unplugged (c) Ben Swift, Cybernetic Studio - CC BY-NC-SA 4.0
  </div>
  <slot />
</ThemeBaseLayout>
