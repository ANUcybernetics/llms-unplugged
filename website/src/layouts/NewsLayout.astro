---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import { findHeroImage } from "../lib/hero-images";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  author?: string;
  date?: Date;
}

const { title, description, ogImage, author, date } = Astro.props;

const formattedDate = date
  ? date.toLocaleDateString("en-AU", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const slug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? "";
const hero = findHeroImage(`hero-news-${slug}`);
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
>
  <div class="content-container news-layout">
    <article class="prose">
      <header class="news-header">
        <h1 class="news-title">{title}</h1>
        {
          (author || date) && (
            <div class="news-meta">
              {author && <span class="author">{author}</span>}
              {author && date && <span class="separator">&middot;</span>}
              {date && (
                <time datetime={date.toISOString()}>{formattedDate}</time>
              )}
            </div>
          )
        }
        {
          hero && (
            <Image
              class="news-hero"
              src={hero}
              alt={`Hero image: ${title}`}
              loading="lazy"
            />
          )
        }
      </header>
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .news-header {
    margin-bottom: 2rem;
  }

  .news-title {
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .news-meta {
    color: var(--at-text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .separator {
    margin: 0 0.5rem;
  }

  .news-hero {
    width: 100%;
    height: auto;
  }
</style>
