---
import type { ImageMetadata } from "astro";
import SidebarLayout from "astro-theme-university/layouts/SidebarLayout.astro";
import CommonHead from "../components/CommonHead.astro";
import { siteConfig, themeLogo, footerOverrides } from "../site-config";
import { getModuleSidebar } from "../lib/module-sidebar";
import { type ModuleStatus, moduleStatusLabels } from "../lib/status";
import faviconAsset from "../assets/favicon.svg";
import "../styles/global.css";
import "../styles/widgets.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: ImageMetadata | string;
  keyIdea?: string;
  audience: string;
  duration: string;
  bases: string[];
  status: ModuleStatus;
  usedIn?: Array<{ title: string; href: string }>;
  noindex?: boolean;
}

// Page artwork comes from a glob with no alt text of its own, so the
// site-wide `socialImageAlt` applies only to the site-wide card.
const {
  title,
  description,
  ogImage,
  keyIdea,
  audience,
  duration,
  bases,
  status,
  usedIn = [],
  noindex,
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") + "/";
const sidebar = await getModuleSidebar();
const slug = currentPath.split("/").filter(Boolean).pop();
---

<SidebarLayout
  title={title}
  description={description}
  sidebar={sidebar}
  currentPath={currentPath}
  sidebarLabel="Modules"
  favicon={faviconAsset}
  logo={themeLogo}
  logoDark={themeLogo}
  {...siteConfig}
  {...footerOverrides}
  socialImage={ogImage ?? siteConfig.socialImage}
  socialImageAlt={ogImage ? undefined : siteConfig.socialImageAlt}
  socialType="article"
>
  <Fragment slot="head">
    <CommonHead noindex={noindex} />
  </Fragment>

  <div class="print-wordmark" data-pagefind-ignore>
    LLMs Unplugged (c) Ben Swift, Cybernetic Studio - CC BY-NC-SA 4.0
  </div>
  {
    /* See BaseLayout: data-pagefind-body opts this page's content into the
       search index; unlisted modules omit it and drop out of search. */
  }
  <div class="prose" data-pagefind-body={noindex ? undefined : ""}>
    <ul class="module-meta">
      <li><strong>Audience</strong> {audience}</li>
      <li><strong>Duration</strong> {duration}</li>
      <li><strong>Runs on</strong> {bases.join(", ")}</li>
      <li>
        <strong>Status</strong>
        <span class={`status-badge status-${status}`}>
          {moduleStatusLabels[status]}
        </span>
      </li>
    </ul>
    {
      keyIdea && (
        <p class="module-key-idea">
          <strong>Key idea:</strong> {keyIdea}
        </p>
      )
    }
    {
      usedIn.length > 0 && (
        <p class="module-used-in">
          Used in{" "}
          {usedIn.map((lesson, i) => (
            <>
              {i > 0 && " and "}
              <a href={lesson.href}>{lesson.title}</a>
            </>
          ))}
          {" --- ready-to-run lessons that include this module."}
        </p>
      )
    }
    <slot />
  </div>
  <div class="edit-link">
    <a
      href={`https://github.com/ANUcybernetics/llms-unplugged/edit/main/website/src/content/modules/${slug}.mdx`}
    >
      Edit this page on GitHub
    </a>
  </div>
</SidebarLayout>

<style>
  .module-meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0 0 1.5rem;
    padding: 0.75rem 0;
    border-block: 1px solid var(--at-divider);
    font-size: 0.95rem;
    color: var(--at-text-secondary);
  }

  .module-meta li {
    margin: 0;
  }

  .module-meta strong {
    color: var(--at-text);
    margin-inline-end: 0.35rem;
  }

  .module-key-idea {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border-inline-start: 4px solid var(--at-accent);
    background: var(--at-accent-soft);
    border-radius: 0 var(--at-border-radius) var(--at-border-radius) 0;
    font-size: 1.05rem;
  }

  .module-used-in {
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
    color: var(--at-text-secondary);
  }

  .edit-link {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--at-divider);
    font-size: 0.875rem;
  }
</style>
