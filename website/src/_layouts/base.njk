<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Ready-to-use teaching resources for understanding how large language models work through hands-on activities. No computers required.' }}">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.llmsunplugged.org{{ page.url }}">
  <meta property="og:title" content="{{ title or 'LLMs Unplugged' }}">
  <meta property="og:description" content="{{ description or 'Ready-to-use teaching resources for understanding how large language models work through hands-on activities. No computers required.' }}">
  <meta property="og:image" content="https://www.llmsunplugged.org/og-image.png">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://www.llmsunplugged.org{{ page.url }}">
  <meta name="twitter:title" content="{{ title or 'LLMs Unplugged' }}">
  <meta name="twitter:description" content="{{ description or 'Ready-to-use teaching resources for understanding how large language models work through hands-on activities. No computers required.' }}">
  <meta name="twitter:image" content="https://www.llmsunplugged.org/og-image.png">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="theme-color" content="#be830e">

  <title>{{ title or "LLMs Unplugged" }}</title>
  <link rel="stylesheet" href="/assets/main.css">
</head>
<body class="min-h-screen bg-anu-black text-anu-white print:bg-anu-white print:text-anu-black flex flex-col">
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="border-b border-anu-gold print:hidden">
    <nav class="max-w-prose mx-auto px-4" aria-label="Main navigation">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="text-lg font-semibold text-anu-white hover:text-anu-gold transition-colors" aria-label="LLMs Unplugged home">
          Home
        </a>

        {# Desktop navigation #}
        {% set navPages = collections.all | eleventyNavigation %}
        <ul class="hidden sm:flex gap-6 sm:gap-8">
          {% for entry in navPages %}
          <li class="relative{% if entry.children.length %} group{% endif %}">
            <a href="{{ entry.url }}" class="text-anu-white hover:text-anu-gold-2 transition-colors{% if page.url | startswith(entry.url) %} font-semibold{% endif %}"{% if page.url | startswith(entry.url) %} aria-current="page"{% endif %}{% if entry.children.length %} aria-haspopup="true"{% endif %}>
              {{ entry.title }}{% if entry.children.length %}<span class="ml-1 text-xs" aria-hidden="true">▾</span>{% endif %}
            </a>
            {% if entry.children.length %}
            <ul class="absolute left-0 top-full mt-1 py-2 bg-anu-black border border-anu-gold/40 rounded min-w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all z-50">
              {% for child in entry.children %}
              <li>
                <a href="{{ child.url }}" class="block px-4 py-2 text-anu-white hover:text-anu-gold-2 hover:bg-anu-gold/10 transition-colors{% if page.url == child.url %} font-semibold{% endif %}"{% if page.url == child.url %} aria-current="page"{% endif %}>
                  {{ child.title }}
                </a>
              </li>
              {% endfor %}
            </ul>
            {% endif %}
          </li>
          {% endfor %}
        </ul>

        {# Mobile menu button #}
        <button
          type="button"
          class="sm:hidden p-2 text-anu-white hover:text-anu-gold transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
          data-menu-toggle
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path class="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path class="menu-icon-close hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      {# Mobile navigation #}
      <div id="mobile-menu" class="hidden sm:hidden pb-4" aria-label="Mobile navigation">
        <ul class="flex flex-col gap-1">
          {% for entry in navPages %}
          <li>
            <a href="{{ entry.url }}" class="block py-2 text-anu-white hover:text-anu-gold-2 transition-colors{% if page.url | startswith(entry.url) %} font-semibold{% endif %}"{% if page.url | startswith(entry.url) %} aria-current="page"{% endif %}>
              {{ entry.title }}
            </a>
            {% if entry.children.length %}
            <ul class="pl-4 flex flex-col gap-1 border-l border-anu-gold/30 ml-2">
              {% for child in entry.children %}
              <li>
                <a href="{{ child.url }}" class="block py-1 text-sm text-anu-white/80 hover:text-anu-gold-2 transition-colors{% if page.url == child.url %} font-semibold text-anu-white{% endif %}"{% if page.url == child.url %} aria-current="page"{% endif %}>
                  {{ child.title }}
                </a>
              </li>
              {% endfor %}
            </ul>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </div>
    </nav>
  </header>

  <main id="main-content" class="flex-1 max-w-prose mx-auto px-4 py-12 w-full print:max-w-full print:mx-0 print:p-4">
    <article class="prose max-w-none print:max-w-full">
      {{ content | safe }}
    </article>
  </main>

  <footer class="border-t border-anu-gold mt-auto print:hidden">
    <div class="max-w-prose mx-auto px-4 py-6 text-sm text-anu-white">
      <p>
        © Ben Swift, <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" class="text-anu-gold-2 hover:text-anu-gold transition-colors">CC BY-NC-SA 4.0</a>.
        <a href="{{ site.repository }}/blob/main/website/src{{ page.inputPath | replace('./src', '') }}" class="text-anu-gold-2 hover:text-anu-gold transition-colors">Source on GitHub</a>
        ·
        <a href="{{ page.inputPath | replace('./src/', '/') }}" class="text-anu-gold-2 hover:text-anu-gold transition-colors" rel="alternate" type="text/markdown">LLM-friendly version</a>
      </p>
      <p class="mt-2">
        A <a href="https://cybernetics.anu.edu.au/cybernetic-studio/" class="text-anu-gold-2 hover:text-anu-gold transition-colors">Cybernetic Studio</a> project at the <a href="https://cybernetics.anu.edu.au" class="text-anu-gold-2 hover:text-anu-gold transition-colors">ANU School of Cybernetics</a>.
      </p>
    </div>
  </footer>

  <script type="module" src="/assets/main.js"></script>
</body>
</html>
