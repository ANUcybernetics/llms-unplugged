/data/*

# but keep frankenstein.txt as the example corpus used in the docs
!/data/frankenstein.txt
# and sycophancy.txt for the sycophancy lesson activity
!/data/sycophancy.txt

# default model name
model.json
cutouts.json

# output directory for generated files
out/

