# PDFs are never committed: published ones live in the Tigris bucket behind
# pdf.llmsunplugged.org (see ops/bucket-sync.py), everything else is build
# output
*.pdf

/data/*

# but keep frankenstein.txt as the example corpus used in the docs, and the
# public-domain Paterson verse the grid decks' pre-trained booklet is built from
!/data/frankenstein.txt
!/data/the-man-from-snowy-river.txt
# and every text written for an activity rather than sourced from somewhere
!/data/originals/

# default model name
model.json
cutouts.json

# output directory for generated files
out/

# Added by cargo
/target
cli/target/

mise.local.toml

.unlighthouse
.jj/
dogfood-output/
.remember/

# Typst templates copied from cli/ at build time
website/src/templates/*.typ

.worktrees/

# project skills are shared, even though the global ignore hides .claude/*
!.claude/skills/

# video: the composition kit's rebuilt-from-data.js, and each composition's VO
# take, render and scratch build output --- see ops/video/README.md
ops/video/_kit/generated/
ops/video/*/assets/voice.*
ops/video/*/renders/
ops/video/*/node_modules/
ops/video/*/review.mp4
ops/video/*/frames/
